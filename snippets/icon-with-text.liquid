<style>
  .icon_width_text_block{width:auto; height:auto;}
</style>

<div class="icon-with-text mb-3" {{ block_attributes }}>
  <div class="icon-with-text__item text-{{ text_alignment1 }} align-items-{{ text_alignment1 | replace:'left','start' | replace:'right','end' }}">
    {%- if icons_1 == 'none' -%}
      {%- if image_1 != blank -%}
        {{ image_1 | image_url: width: 70, height: 70 | image_tag: title: image_1.alt, loading: 'lazy' }}
      {%- endif -%}
    {% else %}
      <div class="accordion-icon_block">
        <svg
          class="icon_width_text_block"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="40px"
          height="40px"
          viewBox="0 0 20 20"
          {{ block.shopify_attributes }}
        >
          {% render 'icon', icon: icons_1 %}
        </svg>
      </div>
    {%- endif -%}
    {% if title1 != blank %}
      <p class="mb-0 text-wrap ">{{ title1 }}</p>
    {% endif %}
  </div>

