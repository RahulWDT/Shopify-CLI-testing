{% if card_product.metafields.dtx['deal-time'].value != blank %}
{% assign endTime = card_product.metafields.dtx['deal-time'].value | date: '%d %b %Y' %}
<div class="product-deal-count mb-3 mx-3" data-end-time="{{endTime}}">
{% if request.page_type == 'product' %}
{% unless block.settings.heading == blank %}
<label class="deal-lable product-label">{{ block.settings.heading }}: </label>
{% endunless %}
{% endif %}
<div class="deal-clock" {{ block.shopify_attributes }}>
<ul class="d-flex justify-content-center flex-wrap">
<li class="days"></li>
<li class="hours"></li>
<li class="minutes"></li>
<li class="seconds"></li>
</ul>
</div>
</div>
{% endif %}

