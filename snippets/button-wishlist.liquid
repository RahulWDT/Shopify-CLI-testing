{% comment %}
  Shopify Wishlist
  Usage:
    - Markup: {%- render 'button-wishlist', product: product -%}
    - Place this snippet inside your existing product card snippet

  Parameters:
    - product: <Shopify product> (required)
{% endcomment %}
<div class="wishlist_button position-relative custom" tabindex="0">
   {%- assign product = closest.product -%}

  <a role="link" aria-label="Add to wishlist" class="add-wishlist {{ class }}" button-wishlist data-product-handle="{{ product.handle }}" title="{{ 'products.wishlist.wishlist_name' | t }}"></a>

</div>