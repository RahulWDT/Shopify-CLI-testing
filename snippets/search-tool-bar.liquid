<!-- Sorting and product count -->

<div class="d-flex flex-wrap gap-4 sorting_count align-items-center">

{%- if show_product_sorting or search.filters != empty -%}  
    {% if show_product_count and search.results.size != 0   %}      
   <div class="filter_count">      
        <div class="number-of-products-count"> 
          {{ 'products.product.count' | t: count: number_of_products }}
        </div>    
    </div>
    {% endif %}    
   
   <form class="facets-vertical-form {% unless show_product_sorting  %}d-none{% endunless %}" id="FacetSortForm">
      <div class="facet-filters sorting caption  d-block d-lg-block d-xl-block">
        <div class="facet-filters__field d-flex align-items-center {% if search.results.size == 0 %} d-none{% endif %}">
          <div class="select w-100">
            {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
            <!-- Visual ul li List -->
            {%- liquid
              for option in search.sort_options
                if option.value == sort_by
                  assign primary_choice = option.name | escape
                endif
              endfor
            %}
            <product-sorting class="sort-by dropdown">
              <button
                class="custom-select-buttons  dropdown-toggle btn btn-primary ps-4 pe-5 py-2 w-100"
                type="button"
                id="dropdownMenuSorting"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                {{ primary_choice }}
              </button>
              <ul class="sort-options dropdown-menu dropdown-menu-light wdt-custom-sorting" aria-labelledby="dropdownMenuSorting">
                {%- for option in search.sort_options -%}
                  <li
                    data-value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                      class="selected"
                    {% endif %}
                  >
                    <input
                      type="radio"
                      name="sort_by"
                      id="sort-by-{{ option.value }}"
                      value="{{ option.value }}"
                      {% if option.value == sort_by %}
                        checked
                      {% endif %}
                    >
                    <label class="dropdown-item btn btn-secondary" for="sort-by-{{ option.value }}">
                     <span>
                     {{ option.name | escape }}  
                     </span> 
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            </product-sorting>
          </div>
        </div>
      </div>
    </form>
 
{%- endif -%}
</div>

