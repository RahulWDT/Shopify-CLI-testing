{%- liquid
  if block.settings.image_2 == blank and block.settings.image_3 == blank
    assign both_images_null = true
  endif
  if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank
    assign all_three_images = true
  endif
%}
{% if all_three_images %}
  
{%- if block.settings.image_1 != blank -%}
        <li class="col">
          <div class="card border rounded-3">
            <a
              {% if block.settings.image_1_link != blank %}
                href="{{ block.settings.image_1_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {%- unless block.settings.image_1 == blank -%}
                {{
                  block.settings.image_1
                  | image_url: width: 1280
                  | image_tag: class: 'img-fluid', loading: 'lazy'
                }}
              {%- endunless -%}
            </a>
          </div>
        </li>
      {%- endif -%}

      {%- if block.settings.image_2 != blank -%}
        <li class="col">
          <div class="card border rounded-3">
            <a
              {% if block.settings.image_2_link != blank %}
                href="{{ block.settings.image_2_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {%- unless block.settings.image_2 == blank -%}
                {{
                  block.settings.image_2
                  | image_url: width: 1280
                  | image_tag: class: 'img-fluid', loading: 'lazy'
                }}
              {%- endunless -%}
            </a>
          </div>
        </li>
      {%- endif -%}

      {%- if block.settings.image_3 != blank -%}
        <li class="col">
          <div class="card border rounded-3">
            <a
              {% if block.settings.image_3_link != blank %}
                href="{{ block.settings.image_3_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {%- unless block.settings.image_3 == blank -%}
                {{
                  block.settings.image_3
                  | image_url: width: 1280
                  | image_tag: class: 'img-fluid', loading: 'lazy'
                }}
              {%- endunless -%}
            </a>
          </div>
        </li>
      {%- endif -%}

{%- endif -%}
