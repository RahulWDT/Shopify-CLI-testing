<style>
  p.fake_counter_p  { margin: 10px 0; align-items: center; display: flex; }
  span.fake_counter_b i{ color: rgb(var(--color-foreground)); } 
  span.fake_counter_b { position: relative; margin-right: 4px;display: flex;align-items: center; }
  span.fake_counter_b svg{margin-right:10px; width:26px; height:26px;}
  .fake_counter_b svg.icon.icon-eye { position: relative; top: 5px; bottom: 0; margin: auto;}
</style>
<p class="fake_counter_p" 
   data-min-count="{{ block.settings.min_count | escape }}"
   data-max-count="{{ block.settings.max_count | escape }}">
  <span class="fake_counter_b">
    {% render 'eye-icon' %}
    <b id="dynamic_counter"></b>
  </span>
  {{ block.settings.text | escape }}
</p>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const counterWrapper = document.querySelector(".fake_counter_p");
    if (!counterWrapper) return;

    const min = Math.ceil(parseInt(counterWrapper.dataset.minCount, 10));
    const max = Math.floor(parseInt(counterWrapper.dataset.maxCount, 10));
    const counterElem = document.getElementById("dynamic_counter");

    let r = Math.floor(Math.random() * (max - min + 1)) + min;

    const myTimeAgo = ['1', '2', '3', '4', '5', '10', '-1', '-2', '-3', '-4', '-5'];
    const plus = ['10', '20', '15'];

    setInterval(() => {
      const randomChange = parseInt(myTimeAgo[Math.floor(Math.random() * myTimeAgo.length)], 10);
      r += randomChange;

      if (r <= 10) {
        r += parseInt(plus[Math.floor(Math.random() * plus.length)], 10);
      }

      if (r > 200) {
        r -= parseInt(plus[Math.floor(Math.random() * plus.length)], 10);
      }

      if (counterElem) {
        counterElem.textContent = r;
      }
    }, 1000);
  });
</script>

