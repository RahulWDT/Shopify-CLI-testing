{% liquid
  if section.settings.content_direction == 'column'
    assign direction = 'flex-column'
    assign vartical_alignment = 'align-items-' | append: section.settings.vartical_alignment
    assign vertical_position = 'justify-content-' | append: section.settings.vertical_position
    assign text_alignment = 'text-' | append: section.settings.vartical_alignment
  elsif section.settings.vertical_on_mobile == true
    assign direction = 'flex-column flex-sm-row'
    assign horizontal_position = 'align-items-' | append: section.settings.horizontal_position
    assign horizontal_alignment = 'justify-content-' | append: section.settings.horizontal_alignment
    assign text_alignment = 'text-' | append: section.settings.horizontal_alignment
  elsif section.settings.vertical_on_mobile == false
    assign direction = 'flex-row'
    assign horizontal_alignment = 'justify-content-' | append: section.settings.horizontal_alignment
    assign horizontal_position = 'text-' | append: section.settings.horizontal_alignment
    assign horizontal_position = 'align-items-' | append: section.settings.horizontal_position
  endif
%}
<div class="custom-section-container color-{{ section.settings.color_scheme }} custom-section-{{ section.id }}" ></div>
<div
  class="custom_section {% if section.settings.full_width %}container-fluid {% else %}container{% endif %}  color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}"
  style="
    {% if section.settings.section_height == 'custom' %}
     --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height != 'custom' %}
     --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
    {% if section.settings.section_height != 'custom' %}
    --section-preview-height: 600px;
    {% endif %}
  "
>
  <div class="image-width-banner {% if section.settings.full_width %}container-fluid {% else %}container{% endif %}  color-{{ section.settings.color_scheme }}"
  style="
    {% if section.settings.section_height == 'custom' %}
     --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height != 'custom' %}
     --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
    {% if section.settings.section_height != 'custom' %}
    --section-preview-height: 600px;
    {% endif %}
  "
>
  <div class="custom_background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div class="border-style  layout_height z-1 gap-style" style="{% render 'border-style', settings: section.settings %} {% if section.settings.border_radius > 0 %} overflow: hidden; {% endif %}">
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings %}
    {% endif %}

    <div
      class="section_container spacing-style d-flex gap-style top-bottom-spacing {{ direction }} {{ vartical_alignment }}  {{ vertical_position }} {{ text_alignment }} {{ horizontal_alignment }} {{ horizontal_alignment_mobile }} {{ horizontal_position }}"
      style="
         --padding-top:{{ section.settings.padding-block-start }}px;
        --padding-bottom:{{ section.settings.padding-block-end }}px;
         --gap-style: max(calc(var(--space-scale, 1.0) * {{ section.settings.grid_space }}px));
      "
    >
      {{ children }}
    </div>
  </div>
</div>
</div>

{% stylesheet %}
    .custom-section{ position: relative;}
    .custom-section-container{ position: absolute; inset: 0;z-index: -2; }
    .custom_section  .custom_background{ grid-area: 1 / -1; }
    .custom_section .custom_background .background_media{ position: absolute; inset: 0; }
    .custom_section .custom_background .background_media :is(img, svg, video){
      width:100%;
      height: 100%;
    }
    .custom_section .section_container{
      position:relative;
      width:100%;
      height:100%;
      min-height:var(--section-min-height, auto);
    }
    .custom_section{display:grid;}
    .icon_with  .section_container {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 991px) {
   .icon_with .section_container   {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 550px)  {
   .icon_with .section_container   {
      grid-template-columns: 1fr;

    }
  }
{% endstylesheet %}
