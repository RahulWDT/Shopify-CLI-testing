              "name": "t:name.card",
              "settings": {
                "padding-block-start": 20,
                "padding-block-end": 20,
                "padding-inline-start": 20,
                "padding-inline-end": 20
              },
              "blocks": [
                {
                  "name": "t:settings.heading",
                  "type": "text",
                  "settings": {
                    "text": "<h4>Heading</h4>"
                  }
                },
                {
                  "name": "t:settings.text",
                  "type": "description",
                  "settings": {
                    "text": "description"
                  }
                },
                {
                  "name": "t:options.button",
                  "type": "button"
                }
              ]
            },
            {
              "type": "grid-block-card",
              "name": "t:name.card",
              "settings": {
                "padding-block-start": 20,
