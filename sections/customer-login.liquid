{% style %}
        {% if section.settings.border_input_style == 'all' %}
        input.form-control.form-control--{{ section.id }} {
        border:var(--bs-input-border-width) solid rgb(var(--color-border));
        border-radius: var(--bs-input-border-radius) !important;
        outline: none !important;
        }
        {% endif %}

        {% if section.settings.border_input_style == 'none' %}
        input.form-control.form-control--{{ section.id }} {
        border: 0px !important;
        border-radius: var(--bs-input-border-radius) !important;
        outline: none !important;
        }
        {% endif %}

        {% if section.settings.border_input_style == "underline" %}
        input.form-control.form-control--{{ section.id }} {background:transparent; border-radius: 0; border:0; {% if settings.input_border_thickness != 0 %} border-bottom: var(--bs-input-border-width) solid rgb(var(--color-border)); {% else %}  border-bottom: 1px solid rgb(var(--color-border)) {% endif %}}
        input.form-control.form-control--{{ section.id }}:focus-visible {outline:none;}
        {% endif %}
    .left_image{
      {% if section.settings.image %}
      background-image:url('{{ section.settings.image | image_url }}');
      {% else %}
        background-image:url('data:image/svg+xml,<svg class="image-placeholder-svg w-100 h-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 525.5 525.5"><path d="M324.5 212.7H203c-1.6 0-2.8 1.3-2.8 2.8V308c0 1.6 1.3 2.8 2.8 2.8h121.6c1.6 0 2.8-1.3 2.8-2.8v-92.5c0-1.6-1.3-2.8-2.9-2.8zm1.1 95.3c0 .6-.5 1.1-1.1 1.1H203c-.6 0-1.1-.5-1.1-1.1v-92.5c0-.6.5-1.1 1.1-1.1h121.6c.6 0 1.1.5 1.1 1.1V308z"></path><path d="M210.4 299.5H240v.1s.1 0 .2-.1h75.2v-76.2h-105v76.2zm1.8-7.2l20-20c1.6-1.6 3.8-2.5 6.1-2.5s4.5.9 6.1 2.5l1.5 1.5 16.8 16.8c-12.9 3.3-20.7 6.3-22.8 7.2h-27.7v-5.5zm101.5-10.1c-20.1 1.7-36.7 4.8-49.1 7.9l-16.9-16.9 26.3-26.3c1.6-1.6 3.8-2.5 6.1-2.5s4.5.9 6.1 2.5l27.5 27.5v7.8zm-68.9 15.5c9.7-3.5 33.9-10.9 68.9-13.8v13.8h-68.9zm68.9-72.7v46.8l-26.2-26.2c-1.9-1.9-4.5-3-7.3-3s-5.4 1.1-7.3 3l-26.3 26.3-.9-.9c-1.9-1.9-4.5-3-7.3-3s-5.4 1.1-7.3 3l-18.8 18.8V225h101.4z"></path><path d="M232.8 254c4.6 0 8.3-3.7 8.3-8.3s-3.7-8.3-8.3-8.3-8.3 3.7-8.3 8.3 3.7 8.3 8.3 8.3zm0-14.9c3.6 0 6.6 2.9 6.6 6.6s-2.9 6.6-6.6 6.6-6.6-2.9-6.6-6.6 3-6.6 6.6-6.6z"></path></svg>');
        background-color: rgba(var(--color-foreground), .1);
      {% endif %}
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
       #recover:target~#login {
          display: none !important;
      }
        #recover, #recover+div {
          display: none;
      }
        #recover:target {
          display: block;
      }
        #recover:target+div {
          display: block;
      }
      form#customer_login .form__message .errors ul {  margin-bottom: 0;}

      .form_container >* a {
          /* color: var(--bs-link-color); */
        color:inherit;
      }
      {% if section.settings.border == 'solid' %}
      .form_container .left_image{
        border-right: var(--bs-border-width) solid rgb(var(--bs-border-color));
      }
      {% endif %}


       @media (max-width: 991.98px) {
         .form_container .left_image{
           border-right: none;
      }
       }
       @media (max-width: 600px) {
       .recover_button {width:100% !important;}
       }
      /* .form__message svg{ width:14px; } */
      .errors ul li{ list-style: none; }
      .errors ul{ padding:0; }
      .form__message svg{flex: 0 0 auto;}
      .form_control :is(h1):empty { display: none; }
{% endstyle %}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div
  class="top-bottom-spacing color-{{ section.settings.color_scheme }} gradient w-100 h-100 z-1"
  style="
    --padding-top:{{ section.settings.padding-block-start }}px;
    --padding-bottom:{{ section.settings.padding-block-end }}px;
  "
>
  <div class="container">
    <div class="row form_container overflow-hidden m-0 {% if section.settings.enable_image == true %} border-style {% endif %}"
        style="{% render 'border-style', settings: section.settings %}"
    >
      {% if section.settings.enable_image %}
        <div class="p-0 col-12 col-lg-6 col-xl-7">
          <div class="left_image p-0 h-100">
            {% comment %}
              {% if section.settings.image != blank %}
                {{
                  section.settings.image
                  | image_url: width: 1000
                  | image_tag: class: 'img-fluid h-100 object-fit-cover w-100'
                }}
              {% else %}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-100 h-100' }}
              {% endif %}
            {% endcomment %}
          </div>
        </div>
      {% endif %}
      <div class="col-12 col-lg-6 form-container color-{{ section.settings.block_color_scheme }} gradient d-flex p-0  {% unless section.settings.enable_image %}mx-auto {% else %} col-xl-5 {% endunless %} {% if section.settings.enable_image == false %} border-style {% endif %}"
      style="{% render 'border-style', settings: section.settings %}" 
      >
        <div id="recover" class="Recover_form my-auto p-3 p-sm-4 p-xl-5 w-100">
          <div class="d-flex flex-column justify-content-center">
            <div class="mb-3 mb-xl-4">
              <h2 class="h2 mb-3" tabindex="-1">{{ 'customer.recover_password.title' | t }}</h2>
              <p class="mb-0">
                {{ 'customer.recover_password.subtext' | t }}
              </p>
            </div>

            {%- form 'recover_customer_password' -%}
              {% assign recover_success = form.posted_successfully? %}
              <div class="mb-3 mb-lg-4">
                <label for="RecoverEmail" class="mb-3 h4"> {{ 'customer.login_page.email' | t }}* </label>
                <input
                  type="email"
                  class="form-control form-control--{{ section.id }}"
                  value=""
                  name="email"
                  id="RecoverEmail"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="RecoverEmail-email-error" autofocus
                  {% endif %}
                  placeholder="{{ 'customer.login_page.placeholder_email' | t }}"
                  required
                >
              </div>
              {%- if form.errors -%}
                <small id="RecoverEmail-email-error" class="form__message">
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13" width="16" height="16">
                    <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2" />
                    <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7" />
                    <path
                      d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z"
                      fill="white" />
                    <path
                      d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z"
                      fill="white" stroke="#EB001B" stroke-width="0.7">
                  </svg>
                  {{ form.errors.messages.form }}
                </small>
              {%- endif -%}
              <div class="d-flex flex-wrap gap-4 align-items-center w-100 recover_button">
                <div class="flex-grow-1">
                  <button class="btn btn-primary w-100 submit-button" type="submit">
                    <span> {{ 'customer.login_page.submit' | t }}</span>
                  </button>
                </div>
                <div class="flex-grow-1 text-center text-md-end text-decoration-underline">
                  <a href="#login">
                    {{ 'customer.login_page.cancel' | t }}
                  </a>
                </div>
              </div>
            {%- endform -%}
          </div>
        </div>
        <div id="login" class="login_form py-3 px-2 p-sm-3 p-md-4  p-xxl-5 d-flex flex-column justify-content-center"
        >
          <div class="form_control p-2">
            <div class="mb-4">
              <h1 class="h2 mb-3" tabindex="-1">
                {{- section.settings.heading -}}
              </h1>
              <p>{{ section.settings.paragraph }}</p>
            </div>

            <svg style="display: none">
              <symbol id="icon-error" viewBox="0 0 13 13">
                <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
              </symbol>
            </svg>
            <!-- alert-success -->
            {%- if recover_success == true -%}
              <div class="alert  d-flex align-items-center bg-body p-0" role="alert">
                <span
                  class="form__message text-start align-items-baseline d-flex form__message gap-2 text-start"
                  tabindex="-1"
                >
                  {% render 'icon-success' %}
                  {{ 'customer.recover_password.success' | t }}
                </span>
              </div>
            {%- endif -%}
            <!-- alert-danger -->
            {%- form 'customer_login', novalidate: 'novalidate' -%}
              {%- if form.errors -%}
                <div class="form__message alert  d-flex flex-column align-items-start bg-body p-0" role="alert">
                  <div class="form_message d-flex align-items-center gap-2 mb-2 ">
                    <svg aria-hidden="true" focusable="false" width="16" height="16">
                      <use href="#icon-error" />
                    </svg>
                    <h6 class="form__message text-start d-flex gap-2 mb-0" tabindex="-1">
                      {{ 'templates.contact.form.error_heading' | t }}
                    </h6>
                  </div>
                  <div class="text-start">{{ form.errors | default_errors }}</div>
                </div>
              {%- endif -%}

              {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
                <section name="sign-in-with-shop-provider">
                  {{ shop | login_button: hide_button: hide_shop_login_button }}

                  {%- unless hide_shop_login_button -%}
                    <p>
                      {{ 'customer.login_page.alternate_provider_separator' | t }}
                    </p>
                  {%- endunless -%}
                </section>
              {%- endif -%}

              <div class="mb-3 mb-lg-4">
                <label for="CustomerEmail" class="mb-3 h4">{{ 'customer.login_page.email' | t }}*</label>
                <input
                  type="email"
                  class="form-control form-control--{{ section.id }}"
                  name="customer[email]"
                  id="CustomerEmail"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                  placeholder="{{'customer.login_page.placeholder_email' | t }}"
                  required
                >
              </div>

              {%- if form.password_needed -%}
                <div class="mb-3 mb-lg-4">
                  <label for="CustomerPassword" class="mb-3 h4">{{ 'customer.login_page.password' | t }}*</label>
                  <input
                    type="password"
                    class="form-control form-control--{{ section.id }}"
                    value=""
                    name="customer[password]"
                    id="CustomerPassword"
                    autocomplete="off"
                    {% if form.errors contains 'form' %}
                      aria-invalid="true"
                    {% endif %}
                    placeholder="{{ 'customer.login_page.password_placeholder' | t }}"
                    required
                  >
                </div>

                <div class="mb-3 mb-lg-4 text-left text-sm-start text-decoration-underline">
                  <a href="{{ routes.account_login_url }}#recover">
                    {{ 'customer.login_page.forgot_password' | t }}
                  </a>
                </div>
              {%- endif -%}
              <div class="d-flex flex-wrap gap-4 align-items-center">
                <div class="flex-grow-1">
                  <button class="btn btn-primary w-100 submit-button" type="submit">
                    <span> {{ 'customer.login_page.sign_in' | t }} </span>
                  </button>
                </div>
                <div class="flex-grow-1 text-center text-md-end text-decoration-underline">
                  <a href="{{ routes.account_register_url }}">
                    {{ 'customer.login_page.create_account' | t }}
                  </a>
                </div>
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- if shop.checkout.guest_login -%}
    <div>
      <hr>
      <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

      {%- form 'guest_login' -%}
        <button>
          {{ 'customer.login_page.guest_continue' | t }}
        </button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:name.login",
  "class": "account-template d-flex flex-column justify-content-center align-items-center h-100 color-scheme",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:settings.enable_login_with_shop",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "enable_image",
      "label": "t:settings.enable_image",
      "default":true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.enable_image == true }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.form_control"
    },
    {
      "type": "color_scheme",
      "id": "block_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<h4>Welcome back</h4>",
    },
    {
      "type": "inline_richtext",
      "id": "paragraph",
      "label": "t:settings.description",
    },
    {
      "type": "select",
      "id": "border_input_style",
      "label": "t:settings.input_style",
      "options": [
        {
          "value": "all",
          "label": "t:options.solid"
        },
        {
          "value": "underline",
          "label": "t:options.underline"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
