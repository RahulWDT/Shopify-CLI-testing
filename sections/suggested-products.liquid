{% style %}
  .customer-who-purchased{height: 120px; max-width: 400px; min-width: 400px; bottom: 20px;  -webkit-transition: all 0.3s linear; transition: all 0.3s linear; z-index:9999;}
  .customer-who-purchased.start-0 .product-data { opacity: 0; transform: translateX(-100px) scale(.8);transition: all .5s;}
  .customer-who-purchased .product-data { opacity: 0; transform: translateX(100px) scale(.8);transition: all .5s;}
  .customer-who-purchased .product-data:before { background-color: rgb(var(--color-background));content: ""  display: block; height: auto; position: absolute; bottom: 0; left: 0; right: 0; top: 0; width: auto  z-index: -1;border-radius: var(--media-radius)  -webkit-box-shadow: 0 0 30px rgb(0 0 0 / 15%); box-shadow:0 0 30px rgb(0 0 0 / 15%);}
  .customer-who-purchased .product-data.active { pointer-events: all; opacity: 1;  transform: translateX(0) scale(1); }
  .customer-who-purchased .product-data p span.timing {      color: rgb(var(--color-link-hover)); }
  .customer-who-purchased .product-data .dT_close {height: 10px;position: absolute;  right: 0px; top: 0px; text-align: center;  width: 10px; pointer-events: all;padding: 8px; }
  .customer-who-purchased .product-data .dT_close svg {  height: 10px; width: 10px;fill:currentcolor; transition: all 0.3s linear;}
  .customer-who-purchased .product-data .dT_close:hover  {color:rgb(var(--color-link-hover));}
  .enquiry-overlay .customer-who-purchased { opacity: 0;}
  .customer-who-purchased .product-data .card-img{ width:120px; height:auto; }
{% endstyle %}

{% if section.settings.display_recent_purchase %}
  <ul class="customer-who-purchased p-0 pe-none w-auto position-fixed {{ section.settings.placement }}  mx-4 mb-0 rounded d-none d-sm-block">
    {% content_for 'blocks' %}
  </ul>
{% endif %}
{% schema %}
{
  "name": "t:name.suggested_product",
  "enabled_on": { "groups": ["custom.overlay"] },
  "class": "customer-purchased",
  "blocks": [{ "type": "_suggested_product" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "display_recent_purchase",
      "label": "t:settings.enable",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "default": "Someone recently bought a"
    },
    {
      "type": "select",
      "id": "placement",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start-0",
          "label": "t:options.left"
        },
        {
          "value": "end-0",
          "label": "t:options.right"
        }
      ],
      "default": "start-0"
    },
  ]
}
{% endschema %}
