{{ 'main-collection-product-grid.css' | asset_url | stylesheet_tag }}

{% style %}
    .product-tab-content:not(.tab_placeholder) {display:none;}
    .product-tab-content.active {display:block;}
       .product-grid.product-grid--{{ section.id }}{
      grid-template-columns:var(--grid-mobile-columns);
    }
    .product-tab-button.btn {
    border-radius: {{ section.settings.btn_border_radius }}px;
  }
    @media screen and (width >= 576px){
     .product-grid.product-grid--{{ section.id }}{
      grid-template-columns:var(--grid-tablet-column);
    }
    }
    @media screen and (width >= 992px){
     .product-grid.product-grid--{{ section.id }}{
      grid-template-columns:var(--grid-laptop-columns);
    }
    }
    @media screen and (width >= 1200px){
     .product-grid.product-grid--{{ section.id }}{
      grid-template-columns:var(--grid-desktop-columns);
    }
    }

  {% if section.settings.btn_style == 'btn-primary' %}
  .product-tab-button.btn.active{
      background-color: rgb(var(--color-secondary-button-bg));
      color:rgb(var(--color-secondary-button-text));
  }
  {% elsif section.settings.btn_style == 'btn-secondary' %}
    .product-tab-button.btn.active{
      background-color: rgb(var(--color-primary-button-bg));
      color:rgb(var(--color-primary-button-text));
  }
  {% endif %}
    .product-tab-button.btn-link.active{
          color: rgb(var(--color-link-hover)) !important;
    }
  /* .product-tab-button.btn:hover {
      background: rgba(var(--color-primary-button-bg));
      color: rgba(var(--color-primary-button-text));
  } */
{% endstyle %}

{%- liquid
  assign show_desktop_slider = false
  assign product_style = section.settings.product_style
  if product_style == 'carousel'
    assign product_style = true
    assign show_desktop_slider = true
  else
    assign product_style = false
    assign show_desktop_slider = false
  endif

  if show_desktop_slider
    assign auto_play = 0
    assign centered_mode = false
    assign loop_slide = false
    assign dots = section.settings.swiper_pagination
    assign space = section.settings.horizontal_gap | default: 0
  endif

  assign slider_desktop = section.settings.columns_desktop | default: 3
  assign slider_laptop = section.settings.columns_desktop | default: 2
  if section.settings.columns_desktop == '5'
    assign slider_tablet = 3
  else
    assign slider_tablet = 2
  endif
  assign slider_mobile = section.settings.columns_mobile | default: 1

  assign collection_item = section.settings.collection

  assign products = section.settings.collection.products
  if products == none
    assign products = (1..section.settings.columns_desktop)
  endif
%}


{% render 'swiper-initialization', space: space, slider_desktop: slider_desktop %}


{% assign collections_count = section.settings.collections | compact | size %}
{% capture swiper_controls %}
    {%- render 'swiper-controls',
      show_desktop_slider: show_desktop_slider,
      section: section,
      settings: section.settings
    -%}
  {% endcapture %}

  {% capture header_block %}
   {% content_for 'block', type: 'header-block', id: 'header-block' %}
  {% endcapture %}



<div class="color-{{ section.settings.color_scheme }}">
  <div
    class="product-tabs {% if section.settings.full_width %}container-fluid{% else %}container{% endif %} product-tabs-{{ block_tab_id }} spacing-style position-relative"
    {{ section.shopify_attributes }}
    style="--padding-top:{{ section.settings.padding-block-start }}px; --padding-bottom:{{ section.settings.padding-block-end }}px;"
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
     {{ header_block }}
    <product-tabs-carousel>
      {% if collections_count > 1 %}
        <div
          class="product-tabs-header tab-buttons d-flex flex-wrap justify-content-{{ section.settings.horizontal_alignment }} gap-style"
          style="--gap-style:max(calc({{ section.settings.tab_horizontal_gap }}px * var(--space-scale))); margin-bottom:{{ section.settings.tab_vertical_gap }}px"
        >
          {% for collection_item in section.settings.collections %}
            {% if collection_item != blank %}
              <button
                class="product-tab-button btn {{ section.settings.btn_style }} {% if forloop.first %}active{% endif %}"
                data-tab="tab-{{ forloop.index }}-{{ block_tab_id }}"
              >
                {{ collection_item.title }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
      {% for collection_item in section.settings.collections %}
        {% if collection_item != blank %}
          <div
            class="product-tab-content  {% if forloop.first %}active{% endif %}"
            id="tab-{{ forloop.index }}-{{ block_tab_id }}"
            data-tab-content="tab-{{ forloop.index }}-{{ block_tab_id }}"
          >
            {% if show_desktop_slider %}
              <div
                data-swiper-slider
                data-slider-options='
                  {
                      "desktop": "{{ slider_desktop }}",
                      "laptop": "{{ slider_laptop }}",
                      "tablet": "{{ slider_tablet }}",
                      "mobile": "{{ slider_mobile }}",
                      "loop": "{{ loop_slide }}",
                      "mode": "{{ centered_mode }}",
                      "auto_play": "{{ auto_play }}",
                      "dots": "{{ dots }}",
                    "space": "{{ space }}"
                  }
                '
              >
                <div class="product-carousel swiper">
                  <div class="product-carousel-wrapper swiper-wrapper ">
                    {% for product in collection_item.products limit: section.settings.products_limit %}
                      <div class="swiper-slide h-auto">
                        {% content_for 'block',
                          type: 'product-card',
                          id: 'product-grid-item',
                          closest.product: product
                        %}
                      </div>
                    {% endfor %}
                  </div>
                  {{ swiper_controls }}
                </div>
              </div>
            {% else %}
              <div
                class="product-grid product-grid--{{ section.id }}"
                style="
                  display:grid;  --grid-desktop-columns: repeat({{ slider_desktop }}, 1fr); --grid-laptop-columns: repeat({{ slider_laptop }},1fr); --grid-tablet-column: repeat({{ slider_tablet }},1fr);
                  --grid-mobile-columns: repeat({{ section.settings.columns_mobile}}, 1fr); row-gap:{{ section.settings.vertical_gap }}px; column-gap:{{ section.settings.horizontal_gap }}px; gap:{{ section.settings.column_gap }}px;
                "
              >
                {% for product in collection_item.products limit: section.settings.products_limit %}
                  <div>
                    {% content_for 'block', type: 'product-card', id: 'product-grid-item', closest.product: product %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <div
          class="product-tab-content tab_placeholder {% if forloop.first %}active{% endif %}"
          id="tab-{{ forloop.index }}-{{ block_tab_id }}"
          data-tab-content="tab-{{ forloop.index }}-{{ block_tab_id }}"
        >
          {% if show_desktop_slider %}
            <div
              data-swiper-slider
              data-slider-options='
                {
                    "desktop": "{{ slider_desktop }}",
                    "laptop": "{{ slider_laptop }}",
                    "tablet": "{{ slider_tablet }}",
                    "mobile": "{{ slider_mobile }}",
                    "loop": "{{ loop_slide }}",
                    "mode": "{{ centered_mode }}",
                    "auto_play": "{{ auto_play }}",
                    "dots": "{{ dots }}",
                  "space": "{{ space }}"
                }
              '
            >
              <div class="product-carousel swiper">
                <div class="product-carousel-wrapper swiper-wrapper ">
                  {% for i in (1..section.settings.products_limit) %}
                    <div class="swiper-slide h-auto desk-{{ slider_desktop }} laptop-{{ slider_laptop }} tablet-{{ slider_tablet }} mobile-{{ slider_mobile }}">
                      {% content_for 'block', type: 'product-card', id: 'product-grid-item', closest.product: product %}
                    </div>
                  {% endfor %}
                </div>
                {{ swiper_controls }}
              </div>
            </div>
          {% else %}
            <div
              class="product-grid product-grid--{{ section.id }}"
              style="
                display:grid;  --grid-desktop-columns: repeat({{ slider_desktop }}, 1fr); --grid-laptop-columns: repeat({{ slider_laptop }},1fr); --grid-tablet-column: repeat({{ slider_tablet }},1fr);
                --grid-mobile-columns: repeat({{ section.settings.columns_mobile}}, 1fr); row-gap:{{ section.settings.vertical_gap }}px; column-gap:{{ section.settings.horizontal_gap }}px; gap:{{ section.settings.column_gap }}px;
              "
            >
              {% for i in (1..section.settings.products_limit) %}
                <div>
                  {% content_for 'block', type: 'product-card', id: 'product-grid-item', closest.product: product %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </product-tabs-carousel>
  </div>
</div>

{% schema %}
{
  "name": "t:name.product_tab",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "class": "product-tabs-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:settings.collection",
      "limit": 5
    },
    {
      "type": "select",
      "id": "product_style",
      "label": "t:settings.product_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "t:settings.products_to_show",
      "default": 8
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "min": 0,
      "max": 30,
      "unit": "px",
      "step": 2,
      "default": 20,
      "label": "t:settings.horizontal_gap"
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "min": 0,
      "max": 30,
      "unit": "px",
      "step": 2,
      "default": 20,
      "label": "t:settings.vertical_gap",
      "visible_if": "{{ section.settings.product_style == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.product_tab"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "btn-primary",
          "label": "Primary"
        },
        {
          "value": "btn-secondary",
          "label": "Secondary"
        },
        {
          "value": "btn-link",
          "label": "Link"
        }
      ],
      "default": "btn-primary"
    },
    {
      "type": "range",
      "id": "btn_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "tab_horizontal_gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "t:settings.horizontal_gap"
    },
    {
      "type": "range",
      "id": "tab_vertical_gap",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "t:settings.vertical_gap"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        },
        {
          "value": "between",
          "label": "t:options.between"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.column"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "options": [
        {
          "value": "3",
          "label": "t:options.column_3"
        },
        {
          "value": "4",
          "label": "t:options.column_4"
        },
        {
          "value": "5",
          "label": "t:options.column_5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.column_1"
        },
        {
          "value": "2",
          "label": "t:options.column_2"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.navigation",
      "visible_if": "{{ section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.nav_style",
      "visible_if": "{{ section.settings.product_style == 'carousel' }}",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrow"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' and section.settings.style == 'arrow' and section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.style == 'arrow'  and section.settings.border != 'none' and section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none'  and section.settings.style == 'arrow' and section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ section.settings.style == 'arrow' and section.settings.product_style == 'carousel'  }}"
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.inherit_color_scheme == false and  section.settings.style == 'arrow' and section.settings.product_style == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:name.product_tab",
      "category": "t:categories.product",
      "blocks": [
        {
          "name": "t:name.header-block",
          "type": "header-block",
          "static": true,
          "id": "header-block",
          "settings": {
            "padding-block-end": 50,
            "horizontal_alignment": "center"
          },
          "blocks": [
            {
              "name": "t:name.header",
              "type": "text",
              "settings": {
                "text": "<h2>Product tab</h2>",
                "padding-block-end": 15
              }
            },
            {
              "name": "t:settings.text",
              "type": "description",
              "settings": {
                "text": "Description",
                "padding-block-end": 15
              }
            },
            {
              "name": "t:settings.button",
              "type": "button"
            }
          ]
        },
        {
          "type": "product-card",
          "static": true,
          "id": "product-grid-item",
          "settings": {
            "inherit_color_scheme": true,
            "color_scheme": "scheme-2",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 20,
            "padding-block-end": 20,
            "padding-inline-start": 20,
            "padding-inline-end": 20
          },
        }
      ]
    }
  ]
}
{% endschema %}
