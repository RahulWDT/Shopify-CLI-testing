{%- assign item = block.settings.product -%}
{%- assign position_left = block.settings.x_axis | append: '%' -%}
{%- assign position_top = block.settings.y_axis | append: '%' -%}
{%- assign content_direction = block.settings.content_direction | default: 'column' -%}
{%- assign alignment = block.settings.horizontal_alignment | default: 'start' -%}
{%- assign position = block.settings.horizontal_position | default: 'start' -%}
{%- assign media_ratio = block.settings.media_aspect_ratio | default: 'portrait' -%}
{% if item.featured_media %}
  {% assign hotspot_image = item.featured_media | image_url: width: 200 %}
{% else %}
  {% assign hotspot_image = 'placeholder' %}
{% endif %}

<div
  class="hotspot-item hotspot-item-{{ forloop.index }} hotspot--{{ block.settings.content_direction }}"
  style="left: {{ position_left }}; top: {{ position_top }};"
>
  <div
    class="hotspot-red tooltip-{{ forloop.index }}"
    data-tooltip='
      {
        "url": "{{ item.url }}",
        "title": "{{ item.title | escape }}",
        "price": "{{ item.price | money }}",
        "image": "{{ hotspot_image }}",
        "direction": "{{ content_direction }}",
        "align": "{{ alignment }}",
        "content_position": "{{ position }}",
        "ratio": "{{ media_ratio }}"
      }
    '
  >
    <span></span>
  </div>
</div>
{% stylesheet %}

  .tooltip-content .placeholder-image .placeholder { width: 70px !important; height: 100%; }
{% endstylesheet %}

<!-- Include Tippy.js (JS + CSS) -->
{{ 'popper.min.js' | asset_url | script_tag }}
{{ 'tippy-bundle.umd.min.js' | asset_url | script_tag }}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const alignmentMap = { start: 'start', center: 'center', end: 'end' };
    const positionMap = { start: 'start', center: 'center', end: 'end', between: 'space-between' };
    const ratioMap = { portrait: '3/4', square: '1/1', landscape: '4/3', adapt: 'auto' };

    let currentIsMobile = window.matchMedia('(max-width: 768px)').matches;
    let initTimeout = null;
    let observer = null;
    let customizerCheckInterval = null;

    function initHotspots() {
      document.querySelectorAll('.hotspot-red').forEach(function (el) {
        // Skip if already initialized (unless we're forcing re-init)
        if (el._tippy && !el._needsReinit) {
          return;
        }

        // Destroy previous instance if it exists
        if (el._tippy) {
          el._tippy.destroy();
          el._tippy = null;
        }

        const data = el.getAttribute('data-tooltip');
        if (!data) return;

        let content = '';

        try {
          const obj = JSON.parse(data);
          const direction = obj.direction || 'column';
          const align = alignmentMap[obj.align] || 'flex-start';
          const content_position = positionMap[obj.content_position] || 'center';
          const ratio = ratioMap[obj.ratio] || '3/4';

          content = `
          <div class="tooltip-content p-2 " style="display:flex; flex-direction:${direction};
            align-items:${content_position}; gap:10px;" data-id="{{ block.id }}">
            <a href="${obj.url}" style="flex-shrink:1;">
              ${
                obj.image && obj.image !== 'placeholder'
                  ? `<img src="${obj.image}" alt="${obj.title || ''}" 
                   style="object-fit:cover;width: 70px;aspect-ratio:${ratio};margin-bottom:5px;">`
                  : `<div class="placeholder-image">
                {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg placeholder ' }}
                </div>`
              }
            </a>
            <div style="display:flex;flex-direction:column;align-items:${align};">
              ${
                obj.title
                  ? `<h6 class="tooltip-content-block" style="text-align:${align};color:black;"><a href="${obj.url}">${obj.title}</a></h6>`
                  : ''
              }
              ${obj.price ? `<p class="m-0" style="color:red; ">${obj.price}</p>` : ''}
            </div>
          </div>`;
        } catch (e) {
          console.error('Invalid JSON in data-tooltip:', e);
          content = data;
        }

        // Check if tippy is available
        if (typeof tippy === 'undefined') {
          console.warn('Tippy.js is not loaded. Please include tippy.js library.');
          return;
        }

        // Initialize tooltip
        try {
          el._tippy = tippy(el, {
            appendTo: document.body,
            content: content,
            allowHTML: true,
            interactive: true,
            trigger: 'click',
            flip: false,
            offset: [0, 10],
            maxWidth: currentIsMobile ? 250 : 500,
            placement: currentIsMobile ? 'bottom' : 'left',
          });
          el._needsReinit = false;
        } catch (error) {
          console.error('Error initializing tippy:', error);
        }
      });
    }

    // Debounced initialization function
    function debouncedInit() {
      if (initTimeout) {
        clearTimeout(initTimeout);
        initTimeout = null;
      }
      initTimeout = setTimeout(function () {
        // Mark all existing hotspots for re-initialization
        document.querySelectorAll('.hotspot-red').forEach(function (el) {
          el._needsReinit = true;
        });
        initHotspots();
        initTimeout = null; // Clear timeout reference after execution
      }, 150);
    }

    // Initialize once on page load
    initHotspots();

    // Re-init when switching between mobile and desktop
    const resizeMediaQuery = window.matchMedia('(max-width: 768px)');
    function handleResize() {
      const isNowMobile = resizeMediaQuery.matches;
      if (isNowMobile !== currentIsMobile) {
        currentIsMobile = isNowMobile;
        // Force re-init for all hotspots
        document.querySelectorAll('.hotspot-red').forEach(function (el) {
          el._needsReinit = true;
        });
        initHotspots();
      }
    }

    // Use addListener for better browser support
    if (resizeMediaQuery.addEventListener) {
      resizeMediaQuery.addEventListener('change', handleResize);
    } else {
      resizeMediaQuery.addListener(handleResize);
    }

    // Watch for DOM changes (Shopify customizer updates)
    if (typeof MutationObserver !== 'undefined') {
      observer = new MutationObserver(function (mutations) {
        let shouldReinit = false;

        mutations.forEach(function (mutation) {
          // Check if hotspots were added
          if (mutation.addedNodes.length > 0) {
            for (let i = 0; i < mutation.addedNodes.length; i++) {
              const node = mutation.addedNodes[i];
              if (node.nodeType === 1) {
                // Element node
                // Check if the node itself is a hotspot or contains hotspots
                if (node.classList && node.classList.contains('hotspot-red')) {
                  shouldReinit = true;
                  break;
                }
                if (node.querySelectorAll && node.querySelectorAll('.hotspot-red').length > 0) {
                  shouldReinit = true;
                  break;
                }
              }
            }
          }

          // Check if hotspot attributes were modified
          if (
            mutation.type === 'attributes' &&
            mutation.target.classList &&
            mutation.target.classList.contains('hotspot-red') &&
            mutation.attributeName === 'data-tooltip'
          ) {
            shouldReinit = true;
          }
        });

        if (shouldReinit) {
          debouncedInit();
        }
      });

      // Start observing the document body for changes
      observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['data-tooltip', 'class'],
      });
    }

    // Also listen for Shopify customizer-specific events if available
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        debouncedInit();
      });

      document.addEventListener('shopify:section:reorder', function (event) {
        debouncedInit();
      });

      document.addEventListener('shopify:section:select', function (event) {
        debouncedInit();
      });

      document.addEventListener('shopify:section:deselect', function (event) {
        debouncedInit();
      });

      // Listen for block updates
      document.addEventListener('shopify:block:select', function (event) {
        debouncedInit();
      });

      document.addEventListener('shopify:block:deselect', function (event) {
        debouncedInit();
      });
    }

    // Additional fallback: Periodically check for new hotspots in customizer mode
    // This helps catch cases where MutationObserver might miss updates
    if (typeof window.Shopify !== 'undefined' && window.Shopify.designMode) {
      customizerCheckInterval = setInterval(function () {
        const hotspots = document.querySelectorAll('.hotspot-red');
        let hasUninitialized = false;

        hotspots.forEach(function (el) {
          if (!el._tippy || el._needsReinit) {
            hasUninitialized = true;
          }
        });

        if (hasUninitialized) {
          debouncedInit();
        }
      }, 2000); // Check every 2 seconds when in customizer mode (less aggressive)
    }

    // Cleanup function (optional, for when script is reloaded)
    window.cleanupHotspots = function () {
      if (observer) {
        observer.disconnect();
        observer = null;
      }
      if (initTimeout) {
        clearTimeout(initTimeout);
        initTimeout = null;
      }
      if (customizerCheckInterval) {
        clearInterval(customizerCheckInterval);
        customizerCheckInterval = null;
      }
      document.querySelectorAll('.hotspot-red').forEach(function (el) {
        if (el._tippy) {
          el._tippy.destroy();
          el._tippy = null;
        }
      });
    };
  });
</script>

{% schema %}
{
  "name": "t:name.product",
  "settings": [
    { "type": "product", "id": "product", "label": "t:settings.select_product" },

    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "column", "label": "t:options.vertical" },
        { "value": "row", "label": "t:options.horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "t:settings.position",
      "options": [
        { "value": "start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.bottom" }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "t:settings.ratio",
      "options": [
        { "value": "portrait", "label": "t:options.portrait" },
        { "value": "square", "label": "t:options.square" },
        { "value": "landscape", "label": "t:options.landscape" },
        { "value": "adapt", "label": "t:options.adapt" }
      ],
      "default": "portrait"
    },

    { "type": "range", "id": "x_axis", "label": "X position (%)", "min": 0, "max": 95, "step": 1, "default": 50 },
    { "type": "range", "id": "y_axis", "label": "Y position (%)", "min": 0, "max": 90, "step": 1, "default": 50 }
  ],
  "presets": [
    {
      "name": "t:name.product",
      "settings": {}
    }
  ]
}
{% endschema %}
