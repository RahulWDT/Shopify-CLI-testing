{% liquid
  assign vartical_alignment = 'align-items-' | append: block.settings.alignment
  assign text_alignment = 'text-' | append: block.settings.alignment
%}
<div class="swiper-slide h-auto " {{ block.shopify_attributes }}>
  <div class="testimonial-card testimonial-card-{{ block.id }} ">
    <div
      class="testimonial-block {% if block.settings.inherit_color == false %}color-{{ block.settings.color_scheme }}{% endif %} d-flex flex-column {{ text_alignment }} {{ vartical_alignment }} border-style spacing-style"
      style="
        {% render 'border-style', settings: block.settings %}
        {% render 'spacing-style', settings: block.settings %}
        gap: max(calc(var(--space-scale, 1.0) * {{ block.settings.grid_space }}px));
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:name.card",
  "tag": null,
  "blocks": [
    { "type": "text" },
    { "type": "button" },
    { "type": "custom-rating" },
    { "type": "icon" },
    {"type": "description"},
    {"type":"image"}
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "inherit_color",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "visible_if": "{{block.settings.inherit_color == false }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "grid_space",
      "label": "t:settings.gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:settings.border"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    { 
      "name": "t:name.card",
      "blocks": [
        {"type": "description"},
        {"type": "custom-rating"},
        {"type": "text"}
      ]
     }
  ]
}
{% endschema %}
