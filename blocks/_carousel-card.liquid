{% liquid
  if block.settings.content_direction == 'column'
    assign direction = 'flex-column'
    assign vartical_alignment = 'align-items-' | append: block.settings.vartical_alignment
    assign text_alignment = 'text-' | append: block.settings.vartical_alignment
  elsif block.settings.vertical_on_mobile == true
    assign direction = 'flex-column flex-sm-row'
    assign horizontal_alignment =  block.settings.horizontal_alignment
    if horizontal_alignment
      assign horizontal_alignment = 'align-items-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment_mobile = 'align-items-' | append: block.settings.horizontal_alignment
    endif  
    assign horizontal_position = 'align-items-sm-' | append: block.settings.horizontal_position
  elsif block.settings.vertical_on_mobile == false
    assign direction = 'flex-row'
    assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
    assign horizontal_position = 'align-items-' | append: block.settings.horizontal_position
  endif
%}

<div class="swiper-slide h-auto">
  <div
    class="d-flex border-style {{ direction }}  {{ vartical_alignment }} {{ text_alignment }} {{ horizontal_alignment }} {{ horizontal_alignment_mobile }} {{ horizontal_position }} overflow-hidden spacing-style {% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }} {% endif %} h-100"
    style="gap:{{ block.settings.grid_space }}px; {% render 'spacing-style', settings:block.settings %} {% render 'border-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
{
  "name": "t:name.carousel-card",
  "blocks": [{ "type": "text" }, { "type": "button" }, { "type": "icon" }, { "type": "image" }, { "type": "group" }],
  "tag": null,
  "settings": [
        {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        },
        {
          "value": "between",
          "label": "t:options.between"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vartical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.carousel-card",
      "settings": {
        "color_scheme": "scheme-3",
      },
      "blocks": [
        {
          "name": "Image",
          "type": "image",
           "settings": {
          }
        },
        {
          "name": "heading",
          "type": "text",
          "settings": {
            "text": "<h2>Your Headline Goes Here</h2>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
