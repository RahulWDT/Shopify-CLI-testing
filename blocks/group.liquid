{% liquid
  if block.settings.content_direction == 'column'
    assign direction = 'flex-column'
    assign vartical_alignment = 'align-items-' | append: block.settings.vartical_alignment
    assign vertical_position = 'justify-content-' | append: block.settings.vertical_position
    assign text_alignment = 'text-' | append: block.settings.vartical_alignment
  elsif block.settings.vertical_on_mobile == true
    assign direction = 'flex-column flex-sm-row'
    assign horizontal_alignment =  block.settings.horizontal_alignment
    if horizontal_alignment
      assign horizontal_alignment = 'align-items-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment_mobile = 'align-items-' | append: block.settings.horizontal_alignment
    endif  
    assign horizontal_position = 'align-items-sm-' | append: block.settings.horizontal_position
  elsif block.settings.vertical_on_mobile == false
    assign direction = 'flex-row'
    assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
    assign horizontal_position = 'align-items-' | append: block.settings.horizontal_position
  endif
%}
<div
  class="border-style overflow-hidden position-relative{% if block.settings.inherit_color_scheme != true and block.settings.background_media == 'none' %} color-{{ block.settings.color_scheme }} text-bg-space{% endif %} w-100"
  style="
    {% render 'text-bg-space', settings: block.settings  %} {% render 'border-style',  settings: block.settings %}
    {% if block.settings.border_radius > 0 %} overflow: hidden; {% endif %}
  " {{ block.shopify_attributes }}
>
{% if block.settings.link %}
    <a
      class="group-container-link position-absolute inset-0 z-2"
      href="{{ block.settings.link }}"
      {% if block.settings.open_in_new_tab %}
        target="_blank"
      {% endif %}
    ></a>
{% endif %}
  <div class="custom_background">
    {% render 'background-media',
      background_media: block.settings.background_media,
      background_image: block.settings.background_image,
      background_image_position: block.settings.background_image_position
    %}
    {% if block.settings.toggle_overlay %}
      {% render 'overlay', settings: block.settings %}
    {% endif %}
  </div>
  <div
    class="position-relative group-block w-100 h-100 d-flex {{ direction }} {{ vartical_alignment }} {{ vertical_position }} {{ text_alignment }} {{ horizontal_alignment }} {{ horizontal_alignment_mobile }} {{ horizontal_position }} spacing-style gap-style"
    style="
      --gap-style: max(calc(var(--space-scale, 1.0) * {{ block.settings.grid_space }}px)); {% render 'spacing-style', settings:block.settings %}
      {% render 'size-style-width', settings: block.settings %} {% render 'size-style-height', settings: block.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
{
  "name": "t:name.group",
  "tag":null,
  "blocks": [
    { "type": "@theme" }, { "type": "@app"}
  ],
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        },
        {
          "value": "between",
          "label": "t:options.between"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vartical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        },
        {
          "value": "between",
          "label": "t:options.between"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        }
        
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.background_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "t:categories.layout",
      "settings": {
        "color_scheme": "scheme-3"
      },
      "blocks": [
        {
        "name": "heading",
        "type": "text",    
        "settings": {
        "text": "<h2>Your Headline Goes Here</h2>"
        }
        },
        {
        "name": "Text",
        "type": "text",    
        "settings": {
        "text": "<p>Your content goes here</p>"
        }
        }
      ]
    },
  ]
}
{% endschema %}
