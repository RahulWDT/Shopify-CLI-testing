{% liquid
  assign content_horizontal_alignment = block.settings.Content_Horizontal_alignment
  assign content_vertical_alignment = block.settings.Content_Vertical_alignment
  assign content_gap = block.settings.content_gap

   case block.settings.aspect_ratio
    when 'square'
      assign ratio = '1'
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
  endcase
%}

{% style %}

          .grid-banner-section-{{ section.id }} .grid-banner-image{
            aspect-ratio: {{ ratio }} !important;
            overflow:hidden;
            height: 100%;
          }
         .placeholder-image svg, media-gallery img{width:100%; height:100%;}
         wdt-swiper-slider{overflow:hidden;}
         .grid-content-block {list-style: none; padding-left:0;}
         .card__inner_wrapper + .shopify-block{height:100%;}
          .grid-content-block.grid-content-block--{{ block.id }}{
           grid-template-columns:1fr;
         }
         @media screen and (width >= 576px){
          .grid-content-block.grid-content-block--{{ block.id }}{
           grid-template-columns:var(--grid-tablet-column);
         }
         }
         @media screen and (width >= 992px){
          .grid-content-block.grid-content-block--{{ block.id }}{
           grid-template-columns:var(--grid-laptop-columns);
         }
         }
         @media screen and (width >= 1200px){
          .grid-content-block.grid-content-block--{{ block.id }}{
           grid-template-columns:var(--grid-desktop-columns);
         }
         }
        /* .custom_carousel_section{ position: relative;} */
         .custom-carousel-container{ position: absolute; inset: 0;z-index: -2; }


  .grid-banner-section-{{ section.id }} .grid-content-block :is(.img-block){z-index: 4;}
  .grid-banner-section-{{ section.id }} .grid-content-block :is(.content-section){z-index: 5;}

  {% if block.settings.placement == 'on_image' %}
   .grid-banner-section-{{ section.id }} .grid-content-block :is(.swiper-slide-content) { display:grid !important; height:100%}

  .grid-banner-section-{{ section.id }} .grid-content-block :is(.img-block,){ height:100%}

  {% endif %}
   .grid-banner-section-{{ section.id }} .grid-content-block :is(.swiper-slide-content) {  height:100%}
     .grid-banner-section-{{ section.id }} .grid-content-block :is(.img-block, .content-section){ grid-area: 1 / -1;}
  .grid-banner-section-{{ section.id }} .grid-content-block :is(.content-section){
  justify-content:{{ content_vertical_alignment }};
  align-items:{{ content_horizontal_alignment }};
  text-align:{{ content_horizontal_alignment }};
  gap:{{ content_gap }}px;
  }
{% endstyle %}

{% liquid
  assign show_desktop_slider = false
  assign layout = block.settings.layout_type
  if layout == 'carousel'
    assign layout = true
    assign show_desktop_slider = true
  else
    assign layout = false
    assign show_desktop_slider = false
  endif

  if show_desktop_slider
    assign auto_play = block.settings.autoplay_delay
    assign centered_mode = false
    assign loop_slide = false
    assign dots = block.settings.swiper_pagination
    assign space = block.settings.horizontal_gap | default: 0
  endif

  assign slider_desktop = block.settings.columns_desktop | default: 3
  assign slider_laptop = block.settings.columns_desktop | minus: 1

  if block.settings.columns_desktop == '1'
    assign slider_laptop = 1
    assign slider_tablet = 1
  elsif block.settings.columns_desktop == '2'
    assign slider_laptop = 2
    assign slider_tablet = 1
  elsif block.settings.columns_desktop == '3'
    assign slider_laptop = 2
    assign slider_tablet = 2
  elsif block.settings.columns_desktop == '4'
    assign slider_laptop = 3
    assign slider_tablet = 2
  endif
  assign slider_mobile = 1
%}

{% render 'swiper-initialization', space: space, slider_desktop: slider_desktop %}

{% capture swiper_controls %}
    {%- render 'swiper-controls',
      show_desktop_slider: show_desktop_slider,
      section: block,
      settings: block.settings,
    -%}
  {% endcapture %}

{% capture blocks %}
        {% content_for 'blocks' %} 
      {% endcapture %}
<div
  style="
    padding-top:{{ block.settings.padding-top }}px;
    padding-bottom:{{ block.settings.padding-bottom }}px;
  "
>
  {% if show_desktop_slider %}
    <wdt-swiper-slider>
      <div
        data-slider-options='
          {
              "desktop": "{{ slider_desktop }}",
              "laptop": "{{ slider_laptop }}",
              "tablet": "{{ slider_tablet }}",
              "mobile": "{{ slider_mobile }}",
              "loop": "{{ loop_slide }}",
              "mode": "{{ centered_mode }}",
              "auto_play": "{{ auto_play }}",
              "dots": "{{ dots }}",
             "space": "{{ space }}"
          }
        '
      >
        <div class="grid-content-block-swiper position-relative swiper" data-swiper-slider>
          <div class="custom_carousel_section-wrapper swiper-wrapper">
            {{ blocks }}
          </div>
          {{ swiper_controls }}
        </div>
      </div>
    </wdt-swiper-slider>
  {% else %}
    <div
      class="grid-content-block grid-content-block--{{ block.id }} h-auto"
      style="
                    display:grid; --grid-desktop-columns: repeat({{ slider_desktop }}, 1fr); --grid-laptop-columns: repeat({{ slider_laptop }},1fr); --grid-tablet-column: repeat({{ slider_tablet }},1fr);
        row-gap:{{ block.settings.vertical_gap }}px; column-gap:{{ block.settings.horizontal_gap }}px;
      "
    >
      {{ blocks }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:settings.content-block",
  "class": "grid-content-block",
  "blocks": [{ "type": "grid-block-card" }],
  "tag": "block",
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.layout_type == 'grid' or block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.layout_type == 'grid'}}"
    },
    {
      "type":"header",
      "content":"t:settings.content_alignment"
    },
     {
      "type": "select",
      "id": "aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.adapt"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:name.aspect-ratio"
    },
    {
      "type": "select",
      "id": "placement",
      "default": "below_image",
      "label": "t:settings.placement",
      "options": [
        {
          "value": "on_image",
          "label": "t:options.on_image"
        },
        {
          "value": "below_image",
          "label": "t:options.below_image"
        }
      ]
    },
    {
      "type": "select",
      "id": "Content_Horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "Content_Vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.placement == 'on_image' }}"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
        {
      "type": "header",
      "content": "t:content.column"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "options": [
        {
          "value": "2",
          "label": "t:options.column_2"
        },
        {
          "value": "3",
          "label": "t:options.column_3"
        },
        {
          "value": "4",
          "label": "t:options.column_4"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "t:content.carousel_settings",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
            {
      "type": "range",
      "id": "autoplay_delay",
      "min": 0,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 2,
      "label": "t:settings.auto_play",
      "visible_if": "{{  block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.nav_style",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrow"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.style == 'arrow' and block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' and block.settings.style == 'arrow' and block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none'  and block.settings.style == 'arrow' and block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style == 'arrow' and block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ block.settings.style == 'arrow' and block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false and block.settings.style == 'arrow' and block.settings.layout_type == 'carousel'}}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-top",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:settings.content-block",
      "category": "t:categories.blog",
      "settings": {
            "layout_type": "carousel",
            "Content_Horizontal_alignment": "center",
            "Content_Vertical_alignment": "center",
            "horizontal_gap": 24,
            "vertical_gap": 24,
            "columns_desktop": "4",
            "placement": "below_image",
            "content_gap": 18,
            "padding-top": 0,
            "padding-bottom": 0
      },
      "blocks": []
    }
  ]
}
{% endschema %}
