
{% liquid
  assign icon_width = block.settings.width
  assign accordion_body_margin_left = icon_width | plus: 16
%}

<style>
.accordion-header .section_block-{{ block.id }} svg{
  width: {{ icon_width }}px;
  height: {{ icon_width }}px;
}
#accordion-{{ block.id }} .accordion-body.accordion-body--{{ block.id }}{
  max-width:90%;
}

{% if block.settings.icon != 'none' %}
  #accordion-{{ block.id }} .accordion-body.accordion-body--{{ block.id }}{
    padding-left: {{ accordion_body_margin_left }}px !important;
  }
{% endif %}

</style>





{% assign icon = 'icon_block_image icon-block-' | append: block.id %}

<div class="accordion-item" {{ block.shopify_attributes }}>
  <h2 class="accordion-header d-flex align-items-center gap-3">
    
    <button
      class="accordion-button align-items-baseline {% unless block.settings.open_by_default %} collapsed{% endunless %}"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#accordion-{{ block.id }}"
      aria-expanded="false"
      aria-controls="accordion-{{ block.id }}"
    >
      {%- if block.settings.icon != 'none'%}
    <div class="icon section_block-{{ block.id }} d-flex me-3">
      <svg
      class="icon_width_text_block {{ icon }}"
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      width="{{ block.settings.width }}"
      height="{{ block.settings.width }}"
      viewBox="0 0 20 20"
      {{ block.shopify_attributes }}
    >
      {%- render 'icon', icon: block.settings.icon -%}
    </svg>
   
    </div>
  {% endif %}
      <span class="accordion-title  mb-0 pe-3 text-reset text-break">{{ block.settings.heading }}</span>
    </button>
  </h2>
  <div
    id="accordion-{{ block.id }}"
    class="accordion-collapse collapse {% if block.settings.open_by_default %} show {% endif %}"
    data-bs-parent="#accordionExample"
  >
    <div class="accordion-body accordion-body--{{ block.id }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

