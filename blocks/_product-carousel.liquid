<div
  class="resource-card {{ block.settings | class_list }} swiper-slide"
  {{ block.shopify_attributes }}
>
  <a
    class="card-link"
    href="{{ block.settings.product.url }}"
  >
  </a>
  {% content_for 'blocks' %}
</div>


{% schema %}
{
  "name": "t:name.product_carousel",
  "tag": null,
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },    
    {
      "type": "paragraph",
      "content": "Width is automatically optimized for mobile."
    }
  ],
  "presets": [
    {
      "name": "t:name.product_carousel",
      "category": "t:categories.product",
      "settings": {       
      },
      "blocks": [
        {
          "type": "featured-media",
          "settings": {
            "product": "{{ closest.product }}"            
          }
        },
        {
          "type": "product-title",
          "settings": {
            "product": "{{ closest.product }}",
            "type_preset": "h5"
          }
        },
        {
          "type": "price",
          "settings": {
            "product": "{{ closest.product }}"
          }
        },
        {
          "type": "wishlist-button",
          "settings": {
            "product": "{{ closest.product }}"
          }
        }
      ]
    }
  ]
}
{% endschema %}
