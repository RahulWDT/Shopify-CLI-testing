<predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
    <div class="field position-relative">
      <input
        class="search__input field__input form-control"
        id="{{ input_id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.search' | t }}"
        {%- if settings.blog_search -%}
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        {%- endif -%}
      >
      <label class="field__label d-none" for="{{ input_id }}">
        {{ 'general.search.search' | t }}
      </label>

      <input type="hidden" name="options[prefix]" value="last">

      <button
        type="reset"
        class="position-absolute top-50 reset__button field__button{% if search.terms == blank %} visually-hidden{% endif %}"
        aria-label="{{ 'general.search.reset' | t }}"
      >
        {% render 'icon-close' %}
      </button>

      <button
        class="search__button field__button position-absolute top-0 bottom-0 m-auto border-0 bg-transparent d-flex align-items-center gap-2 p-2"
        aria-label="{{ 'general.search.search' | t }}"
      >
        {% render 'icon-search' %}
      </button>
    </div>
      <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
        <div class="predictive-search__loading-state">
          <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </div>
      <span class="predictive-search-status visually-hidden py-3" role="status" aria-hidden="true"></span>
  
  </form>
  </predictive-search>

  {% schema %}
{
  "name": "t:name.blog_search", 
  "tag": null,
  "settings": [ 
  ],
  "presets": [
    {
      "name": "t:name.blog_search",
      "category": "t:categories.blog",
      "settings": {       
      }
    }
  ]
}
{% endschema %}
