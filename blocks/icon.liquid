{% style %}
  svg.icon_width_text_block.icon-block-{{ block.id }}, .icon-block-{{ block.id }} .icon_block_image {
    width:{{ block.settings.width }}px !important;
    height:{{ block.settings.width }}px !important;
  }
  .icon-block-{{ block.id }} .icon_block_image{height:auto;}

.icon-block-{{ block.id }} img {
  /* aspect-ratio: 1; */
  object-fit:cover;
}

  .icon-block-{{ block.id }} .placeholder-image{ width:{{ block.settings.width }}px !important; aspect-ratio: 3 / 2; }
  .icon-block-{{ block.id }} .placeholder-image svg{
    background: rgba(var(--color-foreground),.1);
    width: 100%;
    height: 100%;
   }
{% endstyle %}



<div class="icon-block-{{ block.id }}">

{% assign icon = 'icon_block_image icon-block-' | append: block.id %}
{% capture icon %}
   {%- if block.settings.icon != 'none' and block.settings.image_upload == blank -%}
      <svg
      class="icon_width_text_block {{ icon }}"
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      width="{{ block.settings.width }}"
      height="{{ block.settings.width }}"
      viewBox="0 0 20 20"
      {{ block.shopify_attributes }}
    >
      {%- render 'icon', icon: block.settings.icon -%}
    </svg>
  {% elsif block.settings.image_upload != blank %}
  {% liquid
      assign media_width_desktop = '100vw'
      assign media_width_mobile = '100vw'
      assign sizes = '(min-width: 1024px) 1024px, ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
      assign widths = '300, 375, 450, 525, 600, 675, 750, 768, 850, 900, 1024'
    %}
{% assign image_style = 'width: ' | append: block.settings.width | append: 'px;' %}
 {{
      block.settings.image_upload
      | image_url: width: 1024
      | image_tag:
        widths: widths,
        class: icon,
        style: image_style,
        sizes: sizes
    }}
  {% else %}
    <div class="placeholder-image">
      {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg' }}
    </div>
  {% endif %}
{% endcapture %}

<div class="main_icon_block d-inline-block overflow-hidden spacing-style border-style"
style="{% render 'spacing-style', settings:block.settings %}{% render 'border-style', settings:block.settings %}
  ">
{%- if block.settings.link != blank -%}
  <a
    href="{{ block.settings.link }}"
    class="text-block text-{{ block.settings.alignment }}"
    {% if block.settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ icon }}
  </a>
{%- else -%}
  {{ icon }}
{%- endif -%}
  </div>

</div>


