{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'
%}
<style>
    .comparison-banner .img-container {
      width: 100%;
      height: 100%;
    }
    .compare-image-group .compare_after, .compare-image-group .compare_before {
      max-width: 400px;
  }
    .shopify-block { width: 100%; height: auto; }
         .comparison-banner .compare-container.horizontal .drag-slider {
        position: absolute;
        inset: 0;
        cursor: grab;
        opacity: 0;
        /* for Firefox */
        width: 100%;
        height: 100%;
        }

        .comparison-banner .compare-container.horizontal .slider-line {
        position: absolute;
        inset: 0;
        width: {{block.settings.slider_border_width}}px;
        height: 100%;
        background-color: rgb(var(--color-secondary-button-border));
        left: var(--position);
        transform: translateX(-50%);
        pointer-events: none; z-index: 2;
        }
        {% comment %} .comparison-banner .compare_before,.comparison-banner .compare_after
       {
          color: {{block.settings.slider_border}};
      }
         {% endcomment %}
        .comparison-banner .compare-container.horizontal .slider-button {
          z-index: 2;
        --slide-btn-size: 4.3125rem;
        position: absolute;
        background-color:rgb(var(--color-secondary-button-bg));
        color: rgb(var(--color-foreground));
        padding: .5rem;
        display: grid;
        place-items: center;
        top: 50%;
        left: var(--position);
        transform: translate(-50%, -50%);
        pointer-events: none;
        border:var(--border-width) solid rgb(var(--color-secondary-button-border));
        font-size: var(--bs-font-h3-size);
        }

        .comparison-banner .compare-container.horizontal .slider-button svg path{
          fill:rgb(var(--color-secondary-button-text));
        }
       /* verticle position */
        .comparison-banner .product-block{margin-top:120px}
        .comparison-banner .image_block{  z-index:0;}
        .comparison-banner .product-block{ grid-template-columns: minmax(160px, auto) 2fr;}
        .compare-product-feature-img{position:relative;}
        .compare-product-feature-img img{
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        top: 0;
        left: 0;
        }
        .comparison-banner .product_description{
        Overflow:hidden;
        max-height: 3.3rem;
        line-height: var(--bs-body-line-height);
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 5;
        text-overflow: ellipsis;
        display: block;
        }
        .comparison-banner .compare-container .compare-image-container .compare-image-group { display: grid; }
        .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-before,
        .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-after {
        grid-area: 1/-1; overflow: hidden; position: relative; pointer-events: none; -webkit-user-select: none; user-select: none; }
        .comparison-banner .slider-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }

        .comparison-banner .compare-container.horizontal .compare-image-container .compare-image-group > .compare-image-after { z-index: 1;  -webkit-clip-path: inset(0 0 0 var(--position)); clip-path: inset(0 0 0 var(--position));}





    .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-before,
    .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-after {
      {% comment %} height: 600px;    {% endcomment %}
      height: var(--section-min-height);
      {% comment %} max-height: 600px;
      min-height: 200px {% endcomment %}
    }

    /* Tablet */
    @media (max-width: 1200px) {
      .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-before,
      .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-after,
      .before-after-container .comparision--banner {
        height: 450px;
        max-height: 450px;
        min-height: 450px
      }
    }

    /* Mobile */
    @media (max-width: 768px) {
      .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-before,
      .comparison-banner .compare-container .compare-image-container .compare-image-group > .compare-image-after,
      .before-after-container .comparision--banner {
        height: 350px;
        max-height: 350px;
        min-height: 350px
      }
    }
</style>

{% assign after = block.settings.after_text %}
{% assign before = block.settings.before_text %}
{% assign vertical = block.settings.vertical_position %}

<div
  class="comparison-banner  color-{{ block.settings.color_scheme }} comparison-banner-{{ section.id }} position-relative border-style w-100"
  style="{% render 'border-style', settings:block.settings %} "
>
  <div class="row overflow-hidden m-0">
    <div class="p-0 d-flex image_block">
      <div class="img-container w-100 overflow-hidden align-self-stretch">
        <compare-banner>
          <div class="compare-container position-relative horizontal">
            <div class="compare-image-container">
              <div class="compare-image-group position-relative">
                <div class="compare-image-before">
                  {%- if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 2560
                      | image_tag: class: 'image-before slider-image', sizes: sizes, widths: widths
                    }}
                    <div class="w-100 d-flex justify-content-start position-absolute {{ vertical }} p-5">
                      <div class="compare_before text-wrap py-1 px-3 before-after rounded-1 ">
                        {% if block.settings.before_text != blank %}
                          <button class="compare_before btn {{ block.settings.btn_style }}">{{ before }}</button>
                        {% endif %}
                      </div>
                    </div>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg image-before slider-image opacity-50' }}
                    <div
                      class="w-100  d-flex justify-content-start position-absolute  {{ vertical }} p-5"
                    >
                      <div class="compare_before text-wrap py-1 px-3 before-after rounded-1  ">
                        {% if block.settings.before_text != blank %}
                          <button class="compare_before btn {{ block.settings.btn_style }}">{{ before }}</button>
                        {% endif %}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
                <div class="compare-image-after">
                  {%- if block.settings.image2 != blank %}
                    {{
                      block.settings.image2
                      | image_url: width: 2560
                      | image_tag: class: 'image-after slider-image ', sizes: sizes, widths: widths
                    }}
                    <div
                      class="w-100  d-flex justify-content-end position-absolute {{ vertical }} p-5"
                    >
                      <div class="compare_after  text-wrap py-1 px-3  before-after rounded-1 ">
                        {% if block.settings.after_text != blank %}
                          <button class="compare_after btn {{ block.settings.btn_style }}">{{ after }}</button>
                        {% endif %}
                      </div>
                    </div>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg image-after slider-image' }}
                    <div
                      class="w-100  d-flex justify-content-end position-absolute {{ vertical }} p-5"
                    >
                      <div class="compare_after  text-wrap  py-1 px-3  before-after rounded-1 ">
                        {% if block.settings.after_text != blank %}
                          <button class="compare_after btn {{ block.settings.btn_style }}">{{ after }}</button>
                        {% endif %}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            <input
              type="range"
              min="0"
              max="100"
              value="50"
              aria-label="Percentage of before photo shown"
              class="drag-slider"
              tabindex="0"
            >
            <div class="slider-line" aria-hidden="true"></div>

            <div class="slider-button" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="51" height="21" viewBox="0 0 51 21" fill="none">
                <path d="M48 8.66026C49.3333 9.43006 49.3333 11.3546 48 12.1244L36 19.0526C34.6667 19.8224 33 18.8601 33 17.3205L33 3.4641C33 1.9245 34.6667 0.962251 36 1.73205L48 8.66026Z" fill="currentcolor"/>
                <path d="M3 8.66026C1.66667 9.43006 1.66667 11.3546 3 12.1244L15 19.0526C16.3333 19.8224 18 18.8601 18 17.3205L18 3.4641C18 1.9245 16.3333 0.962251 15 1.73205L3 8.66026Z" fill="currentcolor"/>
              </svg>
            </div>
          </div>
        </compare-banner>
      </div>
    </div>
  </div>
</div>
<script>
  if (!customElements.get('compare-banner')) {
    customElements.define(
      'compare-banner',
      class CompareBanner extends HTMLElement {
        constructor() {
          super();
          this.resizeObserver = null;
          this.slider = null;
          this.container = null;
        }

        connectedCallback() {
          this.initSlider();
          this.setupResizeObserver();
        }

        disconnectedCallback() {
          this.cleanup();
        }

        initSlider() {
          this.container = this.querySelector('.compare-container');
          this.slider = this.querySelector('.drag-slider');

          if (this.container && this.slider) {
            this.updateSliderMax();

            // Set initial position to center
            this.centerSlider();

            this.slider.addEventListener('input', (e) => {
              this.container.style.setProperty('--position', `${e.target.value}px`);
            });
          } else {
            console.error('Container or slider not found');
          }
        }

        centerSlider() {
          if (this.container && this.slider) {
            const centerPosition = this.container.clientWidth / 2;
            this.slider.value = centerPosition;
            this.container.style.setProperty('--position', `${centerPosition}px`);
          }
        }

        updateSliderMax() {
          if (this.container && this.slider) {
            this.slider.max = this.container.clientWidth;
            // Maintain current position relative to new width
            const currentValue = parseInt(this.slider.value) || this.container.clientWidth / 2;
            const percentage = currentValue / (parseInt(this.slider.max) || 1);
            this.slider.value = this.container.clientWidth * percentage;
            this.container.style.setProperty('--position', `${this.slider.value}px`);
          }
        }

        setupResizeObserver() {
          if (this.resizeObserver) {
            this.resizeObserver.disconnect();
          }

          this.resizeObserver = new ResizeObserver((entries) => {
            for (let entry of entries) {
              if (entry.target === this.container || entry.target === this) {
                this.updateSliderMax();
              }
            }
          });

          if (this.container) {
            this.resizeObserver.observe(this);
            this.resizeObserver.observe(this.container);
          }
        }

        cleanup() {
          if (this.resizeObserver) {
            this.resizeObserver.disconnect();
          }
          if (this.slider) {
            this.slider.removeEventListener('input', this.handleSliderInput);
          }
        }
      }
    );
  }
</script>
{% schema %}
{
  "name": "t:name.before_after",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.before_image"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "t:settings.after_image"
    },

    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "slider_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1
    },

    {
      "type": "text",
      "id": "before_text",
      "default": "Before",
      "label": "t:settings.before_text"
    },
    {
      "type": "text",
      "id": "after_text",
      "default": "After",
      "label": "t:settings.after_text"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "t:settings.style",
      "default": "btn-primary",
      "options": [
        {
          "value": "btn-primary",
          "label": "t:options.primary"
        },
        {
          "value": "btn-secondary",
          "label": "t:options.secondary"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "top-0 bottom-auto",
          "label": "t:options.top"
        },

        {
          "value": "top-50 translate-middle-y",
          "label": "t:options.center"
        },
        {
          "value": "top-auto bottom-0",
          "label": "t:options.bottom"
        }
      ],
      "default": "top-auto bottom-0"
    },

    {
      "type": "header",
      "content": "t:content.borders"
    },

    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:name.before_after",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
