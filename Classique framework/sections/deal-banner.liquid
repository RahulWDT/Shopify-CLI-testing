{% liquid
  assign text_alignment = 'text-' | append: section.settings.content_alignment
  assign position_alignment = section.settings.position_alignment

  case position_alignment
    when 'top-left'
      assign vartical_alignment = 'justify-content-start'
      assign vertical_position = 'align-items-start'
    when 'top-center'
      assign vartical_alignment = 'justify-content-center'
      assign vertical_position = 'align-items-start'
    when 'top-right'
      assign vartical_alignment = 'justify-content-end'
      assign vertical_position = 'align-items-start'
    when 'middle-left'
      assign vartical_alignment = 'justify-content-start'
      assign vertical_position = 'align-items-center'
    when 'middle-center'
      assign vartical_alignment = 'justify-content-center'
      assign vertical_position = 'align-items-center'
    when 'middle-right'
      assign vartical_alignment = 'justify-content-end'
      assign vertical_position = 'align-items-center'
    when 'bottom-left'
      assign vartical_alignment = 'justify-content-start'
      assign vertical_position = 'align-items-end'
    when 'bottom-center'
      assign vartical_alignment = 'justify-content-center'
      assign vertical_position = 'align-items-end'
    when 'bottom-right'
      assign vartical_alignment = 'justify-content-end'
      assign vertical_position = 'align-items-end'
  endcase
%}

<div class="deal-banner color-{{ section.settings.color_scheme }} deal-banner-{{ section.id }}">
  <div class="deal-content position-relative"
    style="
      {% if section.settings.section_height == 'custom' %}
        --section-min-height: {{ section.settings.section_height_custom }}svh;
      {% else %}
        --section-min-height: var(--section-height-{{ section.settings.section_height }});
      {% endif %}

      {% if section.settings.section_height != 'custom' %}
        --section-preview-height: 600px;
      {% endif %}

      {% if section.settings.background_media == 'image' %}
          background-image: url({{ section.settings.background_image | image_url }});
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {% endif %}
    "
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
    {% if section.settings.background_media == 'image' and section.settings.background_image == blank %}
    <div class="deal-banner-placeholder position-absolute top-0 start-0 w-100 h-100 overflow-hidden">
      {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg w-100 h-100' }}
    </div>
  {% endif %}

    {% if section.settings.toggle_overlay %}
      <div class="deal-banner-overlay position-absolute top-0 start-0 w-100 h-100"
        style="
          {% if section.settings.overlay_style == 'solid' %}
            background-color: {{ section.settings.overlay_color }};
          {% else %}
            background: linear-gradient(
              {{ section.settings.gradient_direction }},
              {{ section.settings.overlay_color }},
              transparent
            );
          {% endif %}
          pointer-events: none;
        "
      ></div>
    {% endif %}

    <div
      class="d-flex spacing-style {{ vartical_alignment }} {{ vertical_position }} {% if section.settings.full_width %}container-fluid{% else %}container{% endif %} layout_height align-content-center position-relative"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="deal-banner-content">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% style %}
  .deal-banner-content {
    width: fit-content;
  }
{% endstyle %}

{% schema %}
{
  "name": "t:name.deal-banner",
  "class": "section deal-banner-section",
  "blocks": [{ "type": "deal-content" }],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "position_alignment",
      "label": "t:settings.position",
      "options": [
        { "value": "top-left", "label": "t:options.top-left" },
        { "value": "top-center", "label": "t:options.top-center" },
        { "value": "top-right", "label": "t:options.top-right" },
        { "value": "middle-left", "label": "t:options.middle-left" },
        { "value": "middle-center", "label": "t:options.middle-center" },
        { "value": "middle-right", "label": "t:options.middle-right" },
        { "value": "bottom-left", "label": "t:options.bottom-left" },
        { "value": "bottom-center", "label": "t:options.bottom-center" },
        { "value": "bottom-right", "label": "t:options.bottom-right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "image", "label": "t:options.image" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.background_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        { "value": "solid", "label": "t:options.solid" },
        { "value": "gradient", "label": "t:options.gradient" }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        { "value": "to top", "label": "t:options.up" },
        { "value": "to bottom", "label": "t:options.down" }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0, "max": 200, "step": 2, "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0, "max": 200, "step": 2, "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:name.deal-banner",
      "blocks": [
        {
          "type": "deal-content",
          "blocks": [
            { "type": "text", "settings": { "padding-block-end": 10, "text": "<h2>Deal Banner</h2>" } },
            { "type": "description", "settings": { "padding-block-end": 10, "text": "Description" } },
            { "type": "deal-timer", "settings": { "padding-block-end": 10 } },
            { "type": "button" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
