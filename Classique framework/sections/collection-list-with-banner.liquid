    .collection-list-with-banner .media-gallery .gallery-content .content-section .content-item:focus-within .content-btn{ visibility: visible; opacity:1;}
    /* .collection-list-with-banner .content-item.highlight .content-title>* , .collection-list-with-banner .content-item:focus-within .content-btn a{color:rgb(var(--color-primary-button-text)); } */
