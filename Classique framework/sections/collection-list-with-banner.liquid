    .collection-list-with-banner .media-gallery .media-image.media.highlight { opacity: 1;}
    .collection-list-with-banner .media-gallery .media-image > img, .collection-list-with-banner .media-gallery .media-image > svg { max-width: 100% !important;}
    .collection-list-with-banner .media-gallery .media-image > svg,
    .collection-list-with-banner .media-block-image svg{ background:rgb(var(--color-secondary-button-bg));}
    .collection-list-with-banner .media-gallery:after {
      position: absolute;
      content: '';
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgb(var(--color-background),{{section.settings.banner_background_opacity}}%);
      z-index: 1;
      }
    /* .collection-list-with-banner .media-gallery .gallery-content .content-section .content-item { width:100%; max-width:100%;cursor:pointer;overflow:hidden; border-bottom: var(--border-width) solid rgb(var(--bs-border-color));transition:var(--bs-transition);} */

