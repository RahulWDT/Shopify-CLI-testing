   .content-section.banner-{{ section.id }}{
      grid-template-columns:var(--grid-mobile-columns);
    }
    @media screen and (width >= 576px){
     .content-section.banner-{{ section.id }}{
      grid-template-columns:var(--grid-tablet-column);
    }
    }
    @media screen and (width >= 992px){
     .content-section.banner-{{ section.id }}{
      grid-template-columns:var(--grid-laptop-columns);
    }
    }
    @media screen and (width >= 1400px){
     .content-section.banner-{{ section.id }}{
      grid-template-columns:var(--grid-desktop-columns);
    }
    }
   wdt-collection-banner-slider, gallery-component{overflow:hidden;}

  wdt-collection-banner-slider, .media-gallery .grid-layout.gallery-content{
    padding-block:calc(6rem * var(--space-scale));
  }
  .collection-list-with-banner .swiper-slide:not(.highlight), .media-gallery .gallery-content .content-section .content-item:not(.highlight) {
      opacity: 0.5;
  }
  div[data-slider-options], .media-gallery .gallery-content .content-section{ height: fit-content; }
{% if section.settings.layout_type == 'grid' %}
  .media-gallery .gallery-content .content-section{
    justify-content: center;
    align-items: center;
  }
@media (min-width:1200px){
  .media-gallery .gallery-content .content-section{ max-width:90%; margin-inline:auto; }
}
{% endif %}


{%- endstyle -%}

{%- capture widths -%} 320, 540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946{%- endcapture -%}
{%- capture media -%}  position-absolute top-0 start-0 w-100 h-100  {%- endcapture -%}

{% liquid
  assign slider_desktop = section.settings.columns_desktop | default: 3
  assign slider_laptop = section.settings.columns_desktop
  assign slider_tablet = 2
  assign slider_mobile = section.settings.columns_mobile | default: 1

  assign space = section.settings.horizontal_gap | default: 0
  assign auto_play = 0
  assign centered_mode = false
  assign loop_slide = false
%}

<div class="collection collections-{{ section.id }} color-{{ section.settings.color_scheme }} gradient top-bottom-spacing"
  style="--padding-top:{{ section.settings.padding_top }}px; --padding-bottom:{{ section.settings.padding_bottom }}px;" 
>
  <div
    class="collection-list-with-banner position-relative px-0 section-{{ section.id }}-padding layout_height {% if section.settings.full_width %}container-fluid  {% else %}container{% endif %}"
    style="
      {% if section.settings.section_height == 'custom' %}
       --section-min-height: {{ section.settings.section_height_custom }}svh;
      {% elsif section.settings.section_height != 'custom' %}
       --section-min-height: var(--section-height-{{ section.settings.section_height }});
      {% endif %}
      {% if section.settings.section_height != 'custom' %}
      --section-preview-height: 600px;
      {% endif %}
    "
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
    <gallery-component>
      <div class="media-gallery h-100">
        {% if section.blocks.size > 0 %}
          {%- for block in section.blocks -%}
            {%- assign collection = block.settings.collection -%}
            <div class="media-image media {{ media }}">
              {%- if block.settings.image != blank -%}
                <img
                  srcset="
                    {%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                    {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
                    {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                    {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {%- if block.settings.image.width >= 1780 -%}{{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                    {%- if block.settings.image.width >= 2000 -%}{{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                    {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                    {%- if block.settings.image.width >= 3840 -%}{{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                    {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                  "
                  sizes="100vw"
                  src="{{ block.settings.image | image_url: width: 2560 }}"
                  loading="lazy"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round }}"
                  class="{{ media }} d-block object-fit-cover"
                >
              {%- elsif collection.featured_image %}
                {{
                  collection.featured_image
                  | image_url: width: 2540
                  | image_tag:
                    sizes: '100vw',
                    height: collection.featured_image.height,
                    width: collection.featured_image.width,
                    widths: widths,
                    loading: 'lazy',
                    class: 'd-block position-absolute top-0 start-0 w-100 h-100 object-fit-cover'
                }}
              {% endif %}

              {%- if block.settings.image == blank and collection.featured_image == blank %}
                {%- assign placeholder_slide = forloop.index | modulo: 3 | plus: 1 -%}
                {{
                  'collection-'
                  | append: placeholder_slide
                  | placeholder_svg_tag: 'placeholder-svg object-fit-cover'
                }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {% if section.blocks.size == 0 %}
          {% for i in (1..3) %}
            <div class="media-image media {{ media }}">
              {%- assign placeholder_slide = forloop.index | modulo: 3 | plus: 1 -%}
              {{ 'collection-' | append: placeholder_slide | placeholder_svg_tag: 'placeholder-svg object-fit-cover' }}
            </div>
          {%- endfor -%}
        {%- endif -%}
        {% if section.settings.layout_type == 'carousel' %}
          <wdt-collection-banner-slider class="h-100 d-flex align-items-{{ section.settings.horizontal_alignment }}">
            <div
              class="overflow-hidden w-100"
              data-slider-options='
                {
                    "desktop": "{{ slider_desktop }}",
                    "laptop": "{{ slider_laptop }}",
                    "tablet": "{{ slider_tablet }}",
                    "mobile": "{{ slider_mobile }}",
                    "loop": "{{ loop_slide }}",
                    "mode": "{{ centered_mode }}",
                    "auto_play": "{{ auto_play }}",
                  "space": "{{space}}"
                }
              '
            >
        {% endif %}
        <div
          class="{% if section.settings.layout_type == 'carousel' %} swiper {% else %} d-flex justify-content-center align-items-{{ section.settings.horizontal_alignment }} w-100 grid-layout{% endif %} gallery-content position-relative h-100"
          {% if section.settings.layout_type == 'carousel' %}
            data-swiper-slider
          {% endif %}
        >
          <div
            class="content-section banner-{{ section.id }} {% if section.settings.layout_type == 'carousel' %} swiper-wrapper{% else %} {{ columns_desktop }}{% endif %}"
           style="row-gap:max(calc(var(--space-scale, 1.0) * {{ section.settings.vertical_gap }}px));">
            {%- for block in section.blocks -%}
              {%- assign collection = block.settings.collection -%}
              {% if section.blocks.size > 0 %}
                <div
                  class="content-item {% if section.settings.layout_type == 'carousel' %}  swiper-slide {% endif %}"
                  tabindex="0"
                >
                  <div class="content {% if section.settings.layout_type == 'carousel' %} text-center justify-content-center align-items-center h-100 {% endif %}" {{ block.shopify_attributes }}> 
                    <div class="content-title text-md-start text-center">
                      <h2 class="gallery__heading text-center inline-richtext m-0 mb-2 text-{{ block.settings.text_transform }}">
                        {% if block.settings.text != blank %}
                          {{ block.settings.text }}
                        {% else -%}
                          {{- collection.title -}}
                        {%- endif %}
                      </h2>
                      {% if block.settings.description != blank %}
                        <p class="text-wrap text-center">{{ block.settings.description }}</p>
                      {% endif %}
                      {% if section.settings.show_count %}
                        {% if collection != blank %}
                          <span class="d-inline-flex gap-3 position-relative">
                            {{- 'products.product.count' | t: count: collection.all_products_count -}}
                          </span>
                        {% endif %}
                      {% endif %}
                    </div>

                    {%- if block.settings.button_link != blank -%}
                      <div class="content-btn mt-2 mt-lg-0 text-center">
                        <a
                          href="{%- if block.settings.button_link == blank -%} {{ collection.url }} {% else %} {{ block.settings.button_link }} {% endif %}"
                          aria-label="{{ block.settings.button_label }}"
                          role="link"
                          class="btn text-wrap btn-{{ block.settings.button_style }} "
                        >
                          <span>{{ block.settings.button_label | escape }}</span>
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            {% if section.blocks.size == 0 and content_for_index contains 'theme-editor' %}
              {% for i in (1..5) %}
                {%- assign placeholder_image_index = forloop.index | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_image = 'collection-' | append: placeholder_image_index -%}
                <div
                  class="content-item swiper-slide"
                  tabindex="0"
                >
                  <div class="content">
                    <div class="content-title">
                      <h2 class="gallery__heading inline-richtext m-0 mb-2">{{ 'onboarding.block_heading' | t }}</h2>
                      {{ 'onboarding.block_text' | t }}
                    </div>
                    <div class="content-btn">
                      <a href="#" class="btn btn-primary">{{ 'onboarding.link_text' | t }}</a>
                    </div>
                  </div>
                  <div class="media-block-image overflow-hidden col-md-3 col-12 px-0">
                    {%- if placeholder_image -%}
                      {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg w-100 h-100 object-fit-cover' }}
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {% endif %}
          </div>
        </div>
        {% if section.settings.layout_type == 'carousel' %}
          </div>
          </wdt-collection-banner-slider>
        {% endif %}
      </div>
    </gallery-component>
  </div>
</div>

{% schema %}
{
  "name": "t:name.collection_list_with_banner",
  "tag": "section",
  "max_blocks": 7,
  "class": "section collection-list-with-banner",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "vertical_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "end"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "range",
      "id": "banner_background_opacity",
      "min": 0,
      "max": 100,
      "unit": "%",
      "step": 1,
      "label": "t:settings.opacity",
      "default": 80
    },
    {
      "type": "header",
      "content": "t:content.column"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "options": [
        {
          "value": "1",
          "label": "t:options.column_1"
        },
        {
          "value": "2",
          "label": "t:options.column_2"
        },
        {
          "value": "3",
          "label": "t:options.column_3"
        },
        {
          "value": "4",
          "label": "t:options.column_4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.column_1"
        },
        {
          "value": "2",
          "label": "t:options.column_2"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings.bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:name.text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Collection heading",
          "label": "t:settings.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "default": "Add short brief about the collection.",
          "label": "t:settings.description"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "select",
          "id": "text_transform",
          "label": "t:settings.testcase",
          "options": [
            {
              "value": "lowercase",
              "label": "t:options.default"
            },
            {
              "value": "uppercase",
              "label": "t:options.uppercase"
            },
            {
              "value": "capitalize",
              "label": "t:options.capitalize"
            }
          ],
          "default": "capitalize"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:settings.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.link"         
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:options.primary"
            },
            {
              "value": "secondary",
              "label": "t:options.secondary"
            },
            {
              "value": "link",
              "label": "t:options.link"
            }
          ],
          "default": "primary",
          "label": "t:settings.style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:name.collection_list_with_banner",
      "blocks": [
        {
          "type": "text",
          "name": "Heading",
          "settings": {
            
          }
        },
        {
          "type": "text",
          "name": "Heading",
          "settings": {
            
          }
        },
        {
          "type": "text",
          "name": "Heading",
          "settings": {
            
          }
        },
        {
          "type": "text",
          "name": "Heading",
          "settings": {
            
          }
        },
        {
          "type": "text",
          "name": "Heading",
          "settings": {
            
          }
        }
      ]
    }
  ]
}
