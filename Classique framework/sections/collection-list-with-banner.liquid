    /* .collection-list-with-banner .media-gallery .gallery-content .content-section .content-item .content-btn{ visibility: hidden; transition:var(--bs-transition); opacity:0;} */
    /* .collection-list-with-banner .media-gallery .gallery-content .content-section .content-item.highlight .content-btn{ visibility: visible; opacity:1;} */

    /* @media screen and (min-width:1200px){
    .collection-list-with-banner .content-section {max-width:1440px;transition:var(--bs-transition);}
    .collection-list-with-banner .content-item.highlight .content{padding-inline:2rem !important;}
    }
    @media screen and (max-width:1199px) and (max-width:768px){
