{% liquid
  assign columns_desktop = section.settings.columns_desktop

  case columns_desktop
    when '1'
      assign columns_desktop = 'row row-cols-1'
    when '2'
      assign columns_desktop = 'row row-cols-md-2'
    when '3'
      assign columns_desktop = 'row row-cols-md-2 row-cols-lg-3'
    else
      assign columns_desktop = 'row row-cols-md-2 row-cols-lg-3 row-cols-xl-4'
  endcase



%}






{%- style -%}
