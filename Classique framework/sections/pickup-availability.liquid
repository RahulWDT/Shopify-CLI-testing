{%- liquid
  assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true
  assign closest_location = pick_up_availabilities.first     
-%}
{%- if pick_up_availabilities.size > 0 -%}
  <product-availability-preview class="product-availability-preview">
    <div class="mt-4 mb-4 p-3 border">
      {%- if closest_location.available -%}
        <p class="mb-1 align-items-baseline  gap-2">
         <span class="text-success">{% render 'icon-success'%}</span>
         <span>{{ 'products.pickup_availability.pick_up_available_at_html' | t: location_name: closest_location.location.name }}</span>
        </p>
        <p class="pick_up_time mb-2">{{ closest_location.pick_up_time }}</p>
        <a href="#" id="ShowPickupAvailabilityDrawer" tabindex="0" class="btn btn-link p-0" data-bs-toggle="offcanvas" data-bs-target="#pickupDrawer" aria-controls="pickupDrawer">
          {%- if pick_up_availabilities.size == 1 -%}
            {{ 'products.pickup_availability.view_store_info' | t }}
          {%- else -%}
            {{ 'products.pickup_availability.check_other_stores' | t }}
          {%- endif -%}
        </a>
      {%- else -%}
        <p class="mb-1 d-flex align-items-baseline  gap-2">
          <span class="text-danger d-flex">
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px"
            viewBox="0 0 100 100" style="enable-background:new 0 0 100 100;" xml:space="preserve">
            <path d="M94,50c0,24.3-19.7,44-44,44S6,74.3,6,50S25.7,6,50,6S94,25.7,94,50 M35.4,31.6c-1.1-1.1-2.8-1.1-3.9,0
            s-1.1,2.8,0,3.9L46.1,50L31.6,64.6c-1.1,1.1-1.1,2.8,0,3.9c1.1,1.1,2.8,1.1,3.9,0L50,53.9l14.6,14.6c1.1,1.1,2.8,1.1,3.9,0
            c1.1-1.1,1.1-2.8,0-3.9L53.9,50l14.6-14.6c1.1-1.1,1.1-2.8,0-3.9c-1.1-1.1-2.8-1.1-3.9,0L50,46.1L35.4,31.6z" fill="#dc3545"/>
            </svg>
          </span>
          <span>{{ 'products.pickup_availability.pick_up_unavailable_at_html' | t: location_name: closest_location.location.name }}</span>
        </p>
        {%- if pick_up_availabilities.size > 1 -%}
          <a href="#" id="ShowPickupAvailabilityDrawer" tabindex="0" class="btn btn-link p-0" data-bs-toggle="offcanvas" data-bs-target="#pickupDrawer" aria-controls="pickupDrawer">
            {{ 'products.pickup_availability.check_other_stores' | t }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </product-availability-preview>

  <product-availability-details
    id="pickupDrawer"
    class="gradient offcanvas offcanvas-end color-{{ settings.offcanvas_color_scheme }} gradient"
    tabindex="-1"
    role="dialog"
    aria-modal="true"
    aria-labelledby="PickupAvailabilityHeading"
  >
      <div class="offcanvas-header position-relative justify-content-between  border-bottom">
      <h3 class="offcanvas-title" id="cartDrawer">{{ 'products.pickup_availability.pick_up_title' | t }}</h3>  
      <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="{{ 'accessibility.close' | t }}">    
      {% render 'cancel.svg' %}   
      </button>  
    </div>
    <div class="offcanvas-body ">
      <div class="offcanvas_content px-0">
       <div class="offcanvas_heading mb-3">  
       <h4 class="offcanvas-title" id="PickupAvailabilityHeading">
        {{ product_variant.product.title | escape }}
      </h4>
      {%- unless product_variant.product.has_only_default_variant -%}
        <p class="pickup-availability-variant pt-2 mb-0 ">
          {%- for product_option in product_variant.product.options_with_values -%}
            {{ product_option.name | escape }}:&nbsp;
            {%- for value in product_option.values -%}
              {%- if product_option.selected_value == value -%}
                <span>{{ value | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- unless forloop.last -%},&nbsp;{%- endunless -%}
          {%- endfor -%}
        </p>
      {%- endunless -%}  
       </div>
      <ul class="list-unstyled" role="list" data-store-availability-drawer-content>
      {%- for availability in pick_up_availabilities -%}
        <li class="pickup_availability_content my-3">
           <h5 class="warehouse-name my-3">{{ availability.location.name | escape }}</h5> 
          <p class="mb-2 d-flex align-items-start gap-2 pickup_available">
            {%- if availability.available -%}
              {% render 'icon-success', class:'text-success' %}
              {{ 'products.pickup_availability.pick_up_available' | t }},
              {{ availability.pick_up_time | downcase }}
               {%- else -%}
               {% render 'icon-error' %}
              {{ 'products.pickup_availability.pick_up_unavailable' | t }}
            {%- endif -%}
          </p>
          {%- assign address = availability.location.address -%}
          <address>
            {{ address | format_address }}
            {%- if address.phone.size > 0 -%}
              <span>{{ address.phone }}</span>
            {%- endif -%}
          </address>
        </li>
      {%- endfor -%}
    </ul>
    </div>
    </div>
  </product-availability-details>
{%- endif -%}
