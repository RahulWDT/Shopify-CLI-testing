{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'

  assign position_alignment = section.settings.position_alignment

  if position_alignment == 'top-left'
    assign vartical_alignment = 'start'
    assign vertical_position = 'start'

  elsif position_alignment == 'top-center'
    assign vartical_alignment = 'center'
    assign vertical_position = 'start'

  elsif position_alignment == 'top-right'
    assign vartical_alignment = 'end'
    assign vertical_position = 'start'

  elsif position_alignment == 'middle-left'
    assign vartical_alignment = 'start'
    assign vertical_position = 'center'

  elsif position_alignment == 'middle-center'
    assign vartical_alignment = 'center'
    assign vertical_position = 'center'

  elsif position_alignment == 'middle-right'
    assign vartical_alignment = 'end'
    assign vertical_position = 'center'

  elsif position_alignment == 'bottom-left'
    assign vartical_alignment = 'start'
    assign vertical_position = 'end'

  elsif position_alignment == 'bottom-center'
    assign vartical_alignment = 'center'
    assign vertical_position = 'end'

  elsif position_alignment == 'bottom-right'
    assign vartical_alignment = 'end'
    assign vertical_position = 'end'
  endif

  assign text_alignment = 'text-sm-' | append: section.settings.text_alignment_content
  assign text_alignment_mobile = 'text-' | append: section.settings.text_alignment_content_mobile
%}

<style>
  .specification-content{
    width:fit-content;
    height:fit-content;
  }
  .specification-main-content.specification-main-content--{{ section.id }} .without-center{ position: sticky; top: 0; height: fit-content;}
  .specification_section.specification_section--{{section.id}} .specification-image-block{
    justify-items:{{ vartical_alignment }};
    align-items:{{ vertical_position }};
  }

    {% if section.settings.image_content_alignment == 'on_image' %}
    .specification_section.specification_section--{{section.id}} .specification-image-block :is(.specification-image, .specification-content, .placeholder-image){ grid-area: 1 / -1;}

    {% endif %}

  {% if section.settings.image_position != 'center' %}
    .specification-main-content.specification-main-content--{{ section.id }}{
      display:grid;
      grid-template-columns:1fr 1fr;
    }
     .specification-main-content.specification-main-content--{{ section.id }} .specification-image-block{
      position: sticky;
      top: 0;
      height: fit-content;
    }
    .specification-main-content.specification-main-content--{{ section.id }} .right-to-left{
      display:grid;
      grid-template-columns:1fr 1fr;
    }
  {% else %}
    .specification-main-content.specification-main-content--{{ section.id }}{
      display:grid;
      grid-template-columns:1fr 1fr 1fr;
    }
  {% endif %}

  {% if section.settings.image_position == 'center' %}
   .specification_section.specification_section--{{section.id}} .specification-block-1 {order:1; position: sticky; top: 0; height: fit-content;}
   .specification_section.specification_section--{{section.id}} .specification-image-block {order:2; }
   .specification_section.specification_section--{{section.id}} .specification-block-2{ order:3; position: sticky; top: 0; height: fit-content;}
  {% endif %}

  {% if section.settings.image_position == 'right' %}
    .specification_section.specification_section--{{section.id}} .specification-block-1 {order:1;}
    .specification_section.specification_section--{{section.id}} .specification-image-block {order:3;}
    .specification_section.specification_section--{{section.id}} .specification-block-2{ order:2;}
  {% endif %}

  @media(max-width:1024px){
   {% if section.settings.image_position == 'center' %} 
  .specification-main-content.specification-main-content--{{ section.id }}{ grid-template-columns:1fr 1fr;}
  {% else %}
    .specification-main-content.specification-main-content--{{ section.id }}{ grid-template-columns:1fr;}
  {% endif %}
  .specification-main-content.specification-main-content--{{ section.id }} .without-center{ order:1; position:static;}
  .specification-main-content.specification-main-content--{{ section.id }} .specification-image-block {order:1; }

   .specification_section.specification_section--{{section.id}} .specification-image-block,
   .specification_section.specification_section--{{section.id}} .specification-block-1, 
   .specification_section.specification_section--{{section.id}} .specification-block-2 {position:static;}

   .specification_section.specification_section--{{section.id}} .specification-image-block{
      grid-column: auto / span 2;
  }

  }

  @media(max-width:576px){
    .specification-main-content.specification-main-content--{{ section.id }} .right-to-left{
      grid-template-columns:1fr 1fr;
    }
  }
  .specification-block-1:empty, .specification-block-2:empty {
    display: none;
}
</style>
{% capture header_block %}
  {% content_for 'block', type: 'header-block', id: 'header-block' %}
{% endcapture %}

<div class="color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div
    class="specification_section specification_section--{{section.id}} {% if section.settings.full_width %}container-fluid {% else %}container{% endif %}  top-bottom-spacing {{ section.settings.custom_class }}"
    style="
      --padding-top:{{ section.settings.padding-block-start }}px;
      --padding-bottom:{{ section.settings.padding-block-end }}px;
    "
    {{ section.shopify_attributes }}
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
    {% if section.settings.image_position == 'center' %}
      {{ header_block }}
    {% endif %}

    <div
      class="specification-main-content specification-main-content--{{ section.id }} gap-style"
      style="--gap-style: max(calc(var(--space-scale, 1.0) * {{ section.settings.grid_space }}px));"
      {{ section.shopify_attributes }}
    >
      <div class=" d-grid specification-image-block specification-image-block-{{ section.id }}">
        {% if section.settings.specification_block_image %}
          <div class="specification-image w-100 h-100">
            {{
              section.settings.specification_block_image
              | image_url: width: 3840
              | image_tag: widths: widths, sizes: sizes, class: 'object-fit-cover  w-100 h-100'
            }}
          </div>
        {% else %}
          <div class="placeholder-image w-100 h-100">
            {{ 'image' | placeholder_svg_tag: 'image-placeholder-svg w-100 h-100' }}
          </div>
        {% endif %}
        <div class="specification-content {% if section.settings.image_content_alignment != 'on_image' %} w-100 {% endif %} {{ text_alignment }}  {{ text_alignment_mobile }} d-flex flex-column gap-2 {% if section.settings.image_content_alignment == 'on_image' %} m-3 p-3  {% if section.settings.inherit_color_scheme == false %} color-{{ section.settings.content_color_scheme }} {% endif %} {% endif %}">
          {% if section.settings.sub_title != blank %}
            <p class="m-0">{{ section.settings.sub_title }}</p>
          {% endif %}

          {% if section.settings.title != blank %}
            <h2 class="m-0">{{ section.settings.title }}</h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="m-0">{{ section.settings.description }}</p>
          {% endif %}
        </div>
      </div>

      {% if section.settings.image_position != 'center' %}<div class="without-center flex-grow-1">{% endif %}
      {% if section.settings.image_position != 'center' %}
        {{ header_block }}
      {% endif %}
      {% if section.settings.image_position != 'center' %}
        <div class="right-to-left  gap-2">
      {% endif %}
      <div class="specification-block-1 specification-block-1--{{ section.id }}">
        {%- content_for 'block', type: 'specification-content-block-1', id: 'specification-content-block-1' -%}
      </div>
      <div class="specification-block-2 specification-block-2--{{ section.id }}">
        {%- content_for 'block', type: 'specification-content-block-2', id: 'specification-content-block-2' -%}
      </div>
      {% if section.settings.image_position != 'center' %}</div>{% endif %}
      {% if section.settings.image_position != 'center' %}</div>{% endif %}
    </div>
  </div>
</div>
