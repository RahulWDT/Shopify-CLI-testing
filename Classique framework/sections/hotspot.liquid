{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'
%}

<div
  class="hotspot-section-{{section.id}} spacing-style px-2 color-{{ section.settings.color_scheme }}"
  style="{%render 'spacing-style', settings: section.settings %}"
>
  <div class="hotspot-section d-md-flex flex-{{ section.settings.content_position }} layout_height p-0  {% if section.settings.full_width %}container-fluid{% else %}container{% endif %}"
    style="
      gap: max(calc(var(--space-scale, 1.0) * {{ section.settings.grid_space }}px));


      {% if section.settings.section_height == 'custom' %}
             --section-min-height: {{ section.settings.section_height_custom }}svh !important;
            {% elsif section.settings.section_height != 'custom' %}
             --section-min-height: var(--section-height-{{ section.settings.section_height }}) !important;
            {% endif %}
            {% if section.settings.section_height != 'custom' %}
            --section-preview-height: 600px !important;
            {% endif %}
    "
    {% if settings.animation != blank %}
      data-aos="{{ settings.animation}}"
    {% endif %}
  >
    {% content_for 'block', type: 'details', id: 'hotspot_details' %}
    <div
      class="wrapper border-style w-100 wrapper-{{ section.id }} align-content-center object-fit-cover overflow-hidden "
      style="background: var(--color-background); {%render 'border-style', settings: section.settings %}"
      {{ section.shopify_attributes }}
    >
      {% if section.settings.image != blank %}
        {% comment %} {% assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio %} {% endcomment %}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag: widths: widths, sizes: sizes, class: 'd-none object-fit-cover d-md-block'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg d-none d-md-block' }}
      {% endif %}

      {% if section.settings.mobile_image != blank %}
        {% comment %}
          {% assign mobile_image_height = section.settings.mobile_image.width
            | divided_by: section.settings.mobile_image.aspect_ratio
          %}
        {% endcomment %}
        {{
          section.settings.mobile_image
          | image_url: width: 3840
          | image_tag:
            widths: widths,
            width: section.settings.image.width,
            height: section.settings.image.height,
            class: 'd-block d-md-none mobile-img'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg  d-block d-md-none mobile-img w-100 ' }}
      {% endif %}

      <div class="hotspots">
        {% for block in section.blocks %}
          {% content_for 'blocks' %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
    @media (max-width: 767px) {
  {% comment %} .wrapper-{{ section.id }} {
    height: 500px;
  } {% endcomment %}

  .hotspot-section-{{ section.id }} .hotspot-section {
    display: flex !important;
    flex-direction: {{section.settings.mobile_content_position}} !important;
  }
      }

      @media (min-width: 768px) {
        .hotspot-section-{{ section.id }} .hotspot-section {
          min-height: var(--section-min-height);
          height: var(--section-min-height);
        }
      }

      .hotspot-section-{{section.id}} .hotspot-item:hover{
        cursor: pointer;
      }



        .wrapper-{{ section.id }} .placeholder-svg {
        max-height: 600px;
        width: 100%;
        height: auto;
        object-fit: cover;
      }

          .tippy-content { position: relative; padding: 5px 0px; z-index: 1; background: rgb(var(--color-background)); border-radius: 4px;}
        .wrapper-{{ section.id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover !important;

    }

           .wrapper-{{ section.id }} { position: relative; overflow: hidden; }


          .hotspots {
          position: absolute;
          left: 0;
          top: 0;
          width: 100%;
          height: 100%;
          background-size: contain;
          z-index: 100;
          .hotspot-item {
            position: absolute;
            &.hotspot-item-1 {
              left: 56%;
              top: 66%;
            }
            &.hotspot-item-2 {
              left: 37%;
              top: 42%;
            }
            &.hotspot-item-3 {
              left: 26%;
              top: 52%;
            }
            .hotspot-red {
              width: 25px;
              height: 25px;
              border: 3px solid #FFF;
              position: absolute;
              left: auto;
              top: auto;
              border-radius: 100%;
              @include single-transition(all,0.2s,ease-out,0);
              &:hover {
                @include transform( scale(1.3,1.3) );
              }
              span {
                width: 15px;
                height: 15px;
                margin: -8px 0 0 -8px;
                border-radius: 100%;
                position: absolute;
                display: flex;
                align-items: center;
                justify-content: center;
                {% comment %} background: rgb(var(--color-secondary-button-text)); {% endcomment %}
                 background: #FFFFFF;
                left: 50%;
                top: 50%;
              }
              &.hotspot-red {
                background: var(--color-secondary-button-bg);
                border-color: transparent;
                animation:pingHotspot 2s ease-in-out infinite;
              }
              {% comment %} &.hotspot-green {
                background: rgba(0,255,0,0.2);
                border-color: green;
              }
              &.hotspot-blue {
                background: rgba(0,0,255,0.5);
                border-color: blue;
              }
              &.hotspot-yellow {
                background: rgba(255,255,0,0.5);
                border-color: yellow;
              } {% endcomment %}
            }
          }
        }
        @keyframes pingHotspot {
          0% { transform:translate(-50%, -50%) scale(0.8); }
          50% { transform: translate(-50%, -50%) scale(1); }
          100% { transform:translate(-50%, -50%) scale(0.8); }
        }
</style>

{% schema %}
{
  "name": "t:name.hotspot",
  "class": "section section-shop-the-look",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "blocks": [{ "type": "_spot-product" }],
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "t:settings.full_width" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.color_scheme" },
    { "type": "header", "content": "t:settings.content" },
    { "type": "image_picker", "id": "image", "label": "t:settings.desktop_image" },
    { "type": "image_picker", "id": "mobile_image", "label": "t:settings.mobile_image" },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "small", "label": "t:options.small" },
        { "value": "medium", "label": "t:options.medium" },
        { "value": "large", "label": "t:options.large" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:settings.content_position",
      "options": [
        { "value": "row", "label": "t:options.left" },
        { "value": "row-reverse", "label": "t:options.right" }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "t:settings.mobile_content_position",
      "options": [
        { "value": "column", "label": "t:options.top" },
        { "value": "column-reverse", "label": "t:options.bottom" }
      ],
      "default": "column"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    { "type": "header", "content": "t:content.padding" },
    {
      "type": "range",
      "id": "padding-block-start",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:settings.top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:settings.bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.hotspot",
      "settings": {},
      "blocks": [
        {
          "type": "details",
          "id": "hotspot_details",
          "static": true,
          "blocks": [
            {
              "type": "text",
              "settings": {
                "text": "<h2>Title</h2>"
              }
            },
            {
              "type": "description",
              "settings": {
                "text": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review."
              }
            },
            {
              "type": "button"
            }
          ]
        },
        { "type": "_spot-product" },
        { "type": "_spot-product" },
        { "type": "_spot-product" }
      ]
    }
  ]
}
{% endschema %}
