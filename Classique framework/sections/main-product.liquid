    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const tabLinks = document.querySelectorAll('.tablinks');
        const tabContents = document.querySelectorAll('.dt-sc-tabs-content');
        const accTitles = document.querySelectorAll('.acc__title');

        // Assign data-id
        tabLinks.forEach((link, i) => {
          const index = i + 1;
          link.dataset.id = `tab-${index}`;
        });

        accTitles.forEach((link, i) => {
          const index = i + 1;
          link.dataset.id = `tab-${index}`;
        });

        tabContents.forEach((content, i) => {
          const index = i + 1;
          content.dataset.id = `tab-${index}`;
        });

        // Set first tab active
        if (tabLinks.length > 0 && tabContents.length > 0) {
          tabLinks[0].classList.add('active-tab');
          tabContents[0].classList.add('active-tab');
        }

        // Tab click event
        tabLinks.forEach((link) => {
          link.addEventListener('click', function () {
            const id = link.dataset.id;

            // Remove active from all
            tabLinks.forEach((l) => l.classList.remove('active-tab'));
            tabContents.forEach((c) => c.classList.remove('active-tab'));

            // Add active to clicked tab
            link.classList.add('active-tab');

            // Show matching content
            const activeContent = document.querySelector(`.dt-sc-tabs-content[data-id="${id}"]`);
            if (activeContent) activeContent.classList.add('active-tab');
          });
        });
      });

      document.addEventListener('DOMContentLoaded', function () {
        const titles = document.querySelectorAll('.acc__title');
        const contents = document.querySelectorAll('.dt-sc-tabs-content');

        titles.forEach((title) => {
          title.addEventListener('click', function (event) {
            const tabID = this.dataset.id;
            const targetContent = document.querySelector('.dt-sc-tabs-content[data-id="' + tabID + '"]');
            0;

            if (this.classList.contains('active-tab')) {
              this.classList.remove('active-tab');
              if (targetContent) targetContent.classList.remove('active-tab');
              return;
            }
            titles.forEach((t) => t.classList.remove('active-tab'));
            contents.forEach((c) => c.classList.remove('active-tab'));

            this.classList.add('active-tab');
            if (targetContent) targetContent.classList.add('active-tab');
          });
        });
      });
    </script>
    <script type="application/json" id="ProductJSON-{{ product.id }}">
