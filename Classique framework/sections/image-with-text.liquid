{% style %}
      .image-width-banner-{{ section.id }}{ position: relative; }
      .image-with-banner-container{ position: absolute; inset: 0;z-index: -2; }

      .image-width-banner .banner_container.banner_container--{{ section.id }} {
        position:relative;
        width:100%;
        height:100%;
        min-height:var(--section-min-height, auto);
      }


  /* .image-with-banner-{{ section.id }} .banner-image {  align-content: start; position:sticky; top:50px; z-index:5;  } */

  /* .banner_container.banner_container--{{ section.id }} .banner-content { position:sticky; top:0; z-index:6; } */

      @media ( max-width:992px ) {
        .banner_container.banner_container--{{ section.id }}{
            flex-wrap:wrap;
        }
        .banner_container.banner_container--{{ section.id }} .banner-content{position:static}
      }

      @media ( max-width:576px ) {
        .banner_container.banner_container--{{ section.id }} {
            display: flex;
            flex-direction: {{ section.settings.image_placement_mobile }};
        }

      }
{% endstyle %}

{% liquid
  if section.settings.image_placement_mobile == 'top'
    assign mobile_position = 'flex-column'
  else
    assign mobile_position = 'flex-column-reverse'
  endif
%}

<div
  class="image-with-banner-container color-{{ section.settings.color_scheme }} image-with-banner-{{ section.id }}"
></div>
<div
  class="image-width-banner  {% if section.settings.full_width %}container-fluid {% else %}container{% endif %}  color-{{ section.settings.color_scheme }}"
>
  <div
    class="banner_container banner_container--{{ section.id }} h-100 position-relative spacing-style d-sm-flex align-items-start flex-sm-{{ section.settings.image_placement }} gap-style top-bottom-spacing"
    style="
       --padding-top:{{ section.settings.padding-block-start }}px;
      --padding-bottom:{{ section.settings.padding-block-end }}px;
       --gap-style: max(calc(var(--space-scale, 1.0) * {{ section.settings.grid_space }}px));
    "
  >
    <div
      class="banner-image d-flex {{ mobile_position }} flex-lg-{{  section.settings.image_placement }} w-100 h-100  border-style size-style align-items-{{ section.settings.desktop_vertical_position }}"
      {{ section.shopify_attributes }}
      style="{% render 'spacing-style', settings:section.settings %} {% render 'border-style', settings:section.settings %} {% render 'size-style-width', settings:section.settings %} "
       {% if settings.animation != blank %}
        data-aos="{{ settings.animation}}"
      {% endif %}
    >
      {% content_for 'block', id: 'image_with_text_image', type: 'image' %}

      <div class="h-100 w-100 d-flex {{ direction }} {{ horizontal_alignment }}">
        {% content_for 'block', id: 'image_with_text_content', type: 'image-with-text-content' %}

        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:name.image_with_text",
  "blocks": [{ "type": "image-with-text-content" }],
  "max_blocks": 1,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:settings.full_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "desktop_vertical_position",
      "label": "t:settings.desktop_vertical_position",
      "options": [
        { "value": "start", "label": "t:options.top" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_placement",
      "label": "t:settings.image_position_desktop",
      "options": [
        {
          "value": "row",
          "label": "t:options.left"
        },
        {
          "value": "row-reverse",
          "label": "t:options.right"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "image_placement_mobile",
      "label": "t:settings.image_position_mobile",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:name.image_with_text",
      "settings": {
        "color_scheme": "scheme-1",
        "image_placement": "row",
        "image_placement_mobile": "column",
        "padding-block-start": 120,
        "padding-block-end": 120
      },
      "blocks": [
        {
          "name": "t:name.header-block",
          "type": "image-with-text-content",
          "id": "image_with_text_content",
          "static": true,
          "settings": {
            "padding-block-end": 50
          },
          "blocks": [
            {
              "name": "t:name.header",
              "type": "text",
              "settings": {
                "text": "<h3>Image with text</h3>",
                "padding-block-end": 15
              }
            },
            {
              "name": "t:settings.text",
              "type": "description",
              "settings": {
                "text": "Description",
                "padding-block-end": 15
              }
            },
            {
              "name": "t:settings.button",
              "type": "button"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
