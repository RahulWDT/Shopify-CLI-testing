{%- style -%}
        {% if section.settings.border_input_style == 'all' %}
        input.form-control.form-control--{{ section.id }} {
        border:var(--bs-input-border-width) solid rgb(var(--color-border));
        border-radius: var(--bs-input-border-radius) !important;
        outline: none !important;
        }
        {% endif %}

        {% if section.settings.border_input_style == 'none' %}
        input.form-control.form-control--{{ section.id }} {
        border: 0px !important;
        border-radius: var(--bs-input-border-radius) !important;
        outline: none !important;
        }
        {% endif %}

        {% if section.settings.border_input_style == "underline" %}
        input.form-control.form-control--{{ section.id }} {background:transparent; border-radius: 0; border:0; {% if settings.input_border_thickness != 0 %} border-bottom: var(--bs-input-border-width) solid rgb(var(--color-border)); {% else %}  border-bottom: 1px solid rgb(var(--color-border)) {% endif %}}
        input.form-control.form-control--{{ section.id }}:focus-visible {outline:none;}
        {% endif %}
     .left_image{
      aspect-ratio:4/3;
    } 
  .form_container >* a {
    color:inherit;
  }
  .terms-condtions p{margin-bottom:0 ;}
  {% if section.settings.border == 'solid' %}
  .form_container .left_image{
    border-right: var(--bs-border-width) solid rgb(var(--bs-border-color));
  }
  {% endif %}
   @media (max-width: 991.98px) {
    .form_container .left_image{
       border-right: none;
  }
   }
  .form__message li>a{text-decoration:none}
  #create_customer .btn.btn-primary:disabled{cursor: not-allowed;  pointer-events: auto;}
  .terms-condtions a{text-decoration:underline;}
    .errors ul li{ list-style: none; }
  .errors ul{ padding:0; }
{%- endstyle -%}

<div
  class="top-bottom-spacing color-{{ section.settings.color_scheme }} gradient w-100 h-100 z-1"
  style="
    --padding-top:{{ section.settings.padding-block-start }}px;
    --padding-bottom:{{ section.settings.padding-block-end }}px;
  "
>
  <div class="container">
    <div class="row form_container overflow-hidden m-0 {% if section.settings.enable_image == true %} border-style {% endif %}"
    style="{% render 'border-style', settings: section.settings %}"
    >
      {% if section.settings.enable_image %}
        <div class="p-0 col-12 col-lg-6 col-xl-7">
          <div class="left_image h-100 w-100">
            {% if section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 1640
                | image_tag: class: 'img-fluid h-100 object-fit-cover w-100'
              }}
            {% else %}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg w-100 h-100' }}
            {% endif %} 
          </div>
        </div>
      {% endif %}

      <div class="col-12 col-lg-6 p-2 color-{{ section.settings.block_color_scheme }} gradient {% unless section.settings.enable_image %} mx-auto {% else %}  col-xl-5{% endunless %} {% if section.settings.enable_image == false %} border-style {% endif %}"
      style="{% render 'border-style', settings: section.settings %}" 
      >
        <div class="py-3 p-2 p-sm-3 p-md-4  p-xxl-5 ">
          <svg style="display: none">
            <symbol id="icon-error" viewBox="0 0 13 13">
              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
            </symbol>
          </svg>
          <div class="pb-4">
            {{ section.settings.heading }}
          </div>
          <p>{{ section.settings.paragraph }}</p>

          {%- form 'create_customer', novalidate: 'novalidate' -%}
            {%- if form.errors -%}
              <div class="form__message alert alert-danger d-flex flex-column align-items-start bg-body" role="alert">
                <div class="form__message text-start border-0 d-flex align-items-center gap-2 mb-3" tabindex="-1">
                  <svg aria-hidden="true" focusable="false" width="14" height="14">
                    <use href="#icon-error"/>
                  </svg>
                  <h6 class="mb-0">{{ 'templates.contact.form.error_heading' | t }}</h6>
                </div>
                <ul>
                  {%- for field in form.errors -%}
                    <li class="text-start">
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#RegisterForm-{{ field }}">
                          {{ form.errors.translated_fields[field] | capitalize }}
                          {{ form.errors.messages[field] }}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            <div class="mb-3 mb-lg-4">
              <label for="RegisterForm-FirstName" class="mb-3 h4">
                {{ 'customer.register.first_name' | t }}
              </label>
              <input
                type="text"
                class="form-control form-control--{{ section.id }}"
                name="customer[first_name]"
                id="RegisterForm-FirstName"
                {% if form.first_name %}
                  value="{{ form.first_name }}"
                {% endif %}
                autocomplete="given-name"
                placeholder="{{ 'customer.addresses.placeholder_first_name' | t }}"
              >
            </div>
            <div class="mb-3 mb-lg-4">
              <label for="RegisterForm-LastName" class="mb-3 h4">
                {{ 'customer.register.last_name' | t }}
              </label>
              <input
                type="text"
                class="form-control form-control--{{ section.id }}"
                name="customer[last_name]"
                id="RegisterForm-LastName"
                {% if form.last_name %}
                  value="{{ form.last_name }}"
                {% endif %}
                autocomplete="family-name"
                placeholder="{{ 'customer.addresses.placeholder_last_name' | t }}"
              >
            </div>
            <div class="mb-3 mb-lg-4">
              <label for="RegisterForm-email" class="mb-3 h4">{{ 'customer.register.email' | t }}*</label>
              <input
                type="email"
                class="form-control form-control--{{ section.id }}"
                name="customer[email]"
                id="RegisterForm-email"
                {% if form.email %}
                  value="{{ form.email }}"
                {% endif %}
                spellcheck="false"
                autocapitalize="off"
                autocomplete="email"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="RegisterForm-email-error"
                {% endif %}
                placeholder="{{ 'customer.login_page.placeholder_email' | t }}"
                required
              >
            </div>

            <div class="mb-3 mb-lg-4">
              <label for="RegisterForm-password" class="mb-3 h4">{{ 'customer.login_page.password' | t }}*</label>
              <input
                type="password"
                class="form-control form-control--{{ section.id }}"
                name="customer[password]"
                autocomplete="off"
                id="RegisterForm-password"
                aria-required="true"
                {% if form.errors contains 'password' %}
                  aria-invalid="true"
                  aria-describedby="RegisterForm-password-error"
                {% endif %}
                placeholder="{{ 'customer.login_page.password_placeholder' | t }}"
                required
              >
            </div>

            <div class="d-flex flex-wrap gap-4 align-items-center">
              <div class="d-flex align-items-center justify-content-between w-100 flex-wrap gap-3 mt-2">
                <button class="btn btn-primary" id="register">
                  <span> {{ 'customer.register.submit' | t }}</span>
                </button>
                <div class="">
                  <span> {{ 'customer.an_acount' | t }} </span>
                  <a href="{{ routes.account_login_url }}" class="text-decoration-underline">
                    {{ 'customer.log_in' | t }}
                  </a>
                </div>
              </div>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:name.registration",
  "class": "account-template d-flex flex-column justify-content-center align-items-center h-100",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
     {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "enable_image",
      "label": "t:settings.enable_image",
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.enable_image == true }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.form_control"
    },
    {
      "type": "color_scheme",
      "id": "block_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<h4>Create account</h4>"
    },
    {
      "type": "inline_richtext",
      "id": "paragraph",
      "label": "t:settings.description"
    },
    {
      "type": "select",
      "id": "border_input_style",
      "label": "t:settings.input_style",
      "options": [
        {
          "value": "all",
          "label": "t:options.solid"
        },
        {
          "value": "underline",
          "label": "t:options.underline"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
