<div class="swiper-slide h-auto">
  <div
    class="swiper-slide-content d-flex flex-column border-style overflow-hidden  {% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }} {% endif %}"
    style="{% render 'border-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% content_for 'block', type: '_grid-banner-image', id: 'grid-banner-image' %}
    <div
      class="content-section d-flex flex-column spacing-style"
      style="{% render 'spacing-style', settings:block.settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:name.card",
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }],
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:name.border"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.card",
      "settings": {
        "color_scheme": "scheme-3"
      },
      "blocks": [
        {
          "name": "t:settings.heading",
          "type": "text",
          "settings": {
            "text": "<h4>Heading</h4>",
            "padding-block-start": 16
          }
        },
        {
          "name": "t:settings.description",
          "type": "description",
          "settings": {
            "text": "description"
          }
        },
        {
          "name": "t:options.button",
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
