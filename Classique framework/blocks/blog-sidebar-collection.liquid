<div class="widget-collection mb-3">
    {% if collections[settings.collection].products.size > 0 %} 
    {% if settings.collection_title != blank %}
    <h5 class="sidebar_title">{{ settings.collection_title }}</h5>  
    {% endif %}
    {% endif %}
    <div class="dT_VProdWrapperOther">  
    <ul class="product-list-style ps-0">                 
      <wdt-swiper-slider>
      <div              
      data-slider-options='
      {
      "desktop": "1",
      "laptop": "1",
      "tablet": "1",
      "mobile": "1",
      "loop": "false",
      "mode": "false",
      "auto_play": "false",
      "space": "0"
      }
      '
      >
      <div class="product-carousel swiper" data-swiper-slider>
      <div class="product-carousel-wrapper swiper-wrapper">
      {% for product in collections[block.settings.collection].products limit: block.settings.collection_limit %}   
      <div class="swiper-slide h-auto">
        {% render 'card-product', card_product : product  %}
      </div>
      {%- endfor -%}
      </div>
       {%- if block.settings.style == 'arrow' -%}
      {% render 'prev-next-controls',
        column_alignment: block.settings.column_alignment,
        placement_selector: 'nav_right container',
        title_class: 'container',
        settings:block.settings 
      %}
    {%- endif -%}
  {%- if block.settings.style == 'dots' -%}
    <div class="swiper-pagination mx-auto"></div>
  {%- endif -%}
      </div>
      </div>
      </wdt-swiper-slider>        
    </ul>                   
    </div>
    </div> 
        {% schema %}
{
  "name": "Blog Collection", 
  "tag": null,
  "settings": [ 
     {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "collection_limit",
      "label": "t:settings.limit",
      "min": 0,
      "max": 5,
      "step": 1,
      "default":3
    },
    {
      "type": "header",
      "content": "t:content.navigation",
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "arrow",
          "label": "t:options.arrow"
        }
      ],
      "default":"none"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.style == 'arrow' }}",
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' and block.settings.style == 'arrow'}}" 
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.style == 'arrow'  and block.settings.border != 'none' }}",
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none'  and block.settings.style == 'arrow' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ block.settings.style == 'arrow' }}",
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false  }}"
    }
  ],
  "presets": [
    {
      "name": "Blog Collection",
      "category": "Blog",
      "settings": {       
      },
      "blocks": [
             
      ]
    }
  ]
}
{% endschema %}