{% style %}
.specification-block-content-2{
  display:grid;
  grid-template-columns:1fr;
}
{% endstyle %}

  <div class="z-1 spacing-style"
  style=" {% render 'spacing-style', settings: block.settings  %}"
  >
      <div class="specification-block-content-2">
         {% content_for 'blocks' %} 
        </div>
  </div>

{% schema %}
{
  "name": "t:name.content-block-2",
  "blocks": [{ "type": "specification-block-card" }],
  "tag": "block",
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
        {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.content-block-2",
      "settings": {
      },
      "blocks": []
    }
  ]
}
{% endschema %}
