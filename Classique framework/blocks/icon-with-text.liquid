{%  liquid
  assign text_value = block.settings.icon_text
%}

{% style %}
  .icon-text-block-{{ block.id }} .icon svg{
    fill: rgba(var(--color-link), 1);
    width:{{ block.settings.width }}px !important;
    height:{{ block.settings.width }}px !important;
   }
.icon-text.icon-text--{{ block.id }} p{
margin:0px;
}
{% endstyle %}

{% assign icon = 'icon-block-' | append: block.id %}

{% capture icon %}

      <svg
      class="icon-block {{ icon }}"
      aria-hidden="true"
      focusable="false"
      xmlns="http://www.w3.org/2000/svg"
      width="{{ block.settings.width }}"
      height="{{ block.settings.width }}"
      viewBox="0 0 20 20"
      {{ block.shopify_attributes }}
    >
      {%- render 'icon', icon: block.settings.icon -%}
    </svg>
{% endcapture %}

<div class="icon-main-block overflow-hidden spacing-style d-flex flex-column" style="{% render 'spacing-style', settings:block.settings %}; align-items:inherit;" >
<div
  class="icon-text-block-{{ block.id }}  d-flex gap-3"
 
>
    {% if block.settings.icon !='none' %}
  <a
    {% if block.settings.icon == 'email' %}
    href="mailto:{{ text_value }}"
    {% endif %}
    {% if block.settings.icon == 'phone' %}
    href="tel:{{ text_value }}"
    {% endif %}
    class="icon"
    {% if block.settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ icon }}
  </a>
  {% endif %}
  
  <div class="icon-text icon-text--{{ block.id }} m-0 p">
    {{ text_value }}
  </div>
</div>
</div>
{% schema %}
{
  "name": "t:name.icon-with-text",
  "tag":null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "location",
          "label": "t:options.location"
        },
        {
          "value": "phone",
          "label": "t:options.phone"
        },
        {
          "value": "email",
          "label": "t:options.email"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none"
    },
    {
      "type": "richtext",
      "id": "icon_text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 24,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{block.settings.icon != 'none' }}",
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.icon-with-text",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
