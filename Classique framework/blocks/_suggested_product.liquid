{%- assign product = all_products[block.settings.product] -%}
<li
  class="card product-data shadow color-{{ section.settings.color_scheme }} gradient flex-row align-items-center position-absolute z-3 bottom-0 start-0 w-100 h-auto  shadow gap-3 border-style spacing-style"
  style="{% render 'border-style', settings: block.settings %} {% render 'spacing-style', settings:block.settings %}"
  {{ block.shopify_attributes }}
>
  <div class="card-img overflow-hidden">
    <a href="{{ product.url | within: collection }}" class="link">
      {% unless product.featured_image == blank %}
        <img
          loading="lazy"
          src="{{ product.featured_image | image_url : width: 100 }}"
          alt="{{ product.featured_image.src.alt | escape }}"
          width="100"
          height="100"
          class="img-fluid"
        >
      {% else %}
        {%- capture placeholder -%}
        {%- cycle 'hero-apparel-1', 'hero-apparel-2' -%}
        {%- endcapture -%}
        {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
      {% endunless %}
    </a>
  </div>
  <div class="product-content card-body w-100">
    <p class="collection-link card-title h6">
      <a href="{{ product.url | within: collection }}" class="link">
        <span class="title">{{ product.title | truncatewords: 5 }}</span>
      </a>
    </p>
    <span class="purchased card-text">{{ section.settings.text }}</span>
    {% if block.settings.from != blank %}
      <span class="location card-text">from {{ block.settings.from }}</span>
    {% endif %}
    <p class="timing-data m-0 text-end">
      <span class="timing">{{ block.settings.time }}</span>
    </p>
  </div>
  <a href="javascript:void(0)" onclick="event.preventDefault()" title="Close" class="dT_close btn-close">
    {% render 'cancel.svg' %}
  </a>
</li>

{% schema %}
{
  "name": "t:name.product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "text",
      "id": "from",
      "default": "Texas, US",
      "label": "t:settings.location"
    },
    {
      "type": "text",
      "id": "time",
      "default": "10 minutes ago",
      "label": "t:settings.time"
    },
    {
      "type": "header",
      "content": "t:name.border"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [{ "name": "t:name.product" }]
}
{% endschema %}
