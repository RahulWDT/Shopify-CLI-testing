{% liquid
  if block.settings.content_direction == 'column'
    assign direction = 'flex-column'
    assign vartical_alignment = 'align-items-sm-' | append: block.settings.vartical_alignment
    assign text_alignment = 'text-sm-' | append: block.settings.vartical_alignment
    assign align_content = 'align-items-sm-' | append: block.settings.vartical_alignment
    assign alignment_mobile = 'align-items-' | append: block.settings.alignment_mobile
    assign align_content_mobile = 'align-items-' | append: block.settings.alignment_mobile
    assign text_alignment_mobile = 'text-' | append: block.settings.alignment_mobile

  elsif block.settings.vertical_on_mobile == true
    assign direction = 'flex-column flex-sm-row'
    assign horizontal_alignment = block.settings.horizontal_alignment
    if horizontal_alignment
      assign horizontal_alignment = 'align-items-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
      assign horizontal_alignment_mobile = 'align-items-' | append: block.settings.horizontal_alignment
      assign text_alignment = 'text-sm-' | append: block.settings.horizontal_alignment
      assign align_content = 'justify-content-' | append: block.settings.horizontal_alignment
      assign text_alignment_mobile = 'text-' | append: block.settings.alignment_mobile
    endif
    assign horizontal_position = 'align-items-sm-' | append: block.settings.horizontal_position
  elsif block.settings.vertical_on_mobile == false
    assign direction = 'flex-row'
    assign horizontal_alignment = 'justify-content-' | append: block.settings.horizontal_alignment
    assign horizontal_position = 'align-items-' | append: block.settings.horizontal_position
    assign align_content = 'justify-content-' | append: block.settings.horizontal_alignment
     assign text_alignment = 'text-sm-' | append: block.settings.horizontal_alignment
     assign text_alignment_mobile = 'text-' | append: block.settings.alignment_mobile
  endif
%}

<div
  class="d-flex border-style {{ direction }} {{ alignment_mobile }} {{ text_alignment_mobile }} {{ vartical_alignment }} {{ text_alignment }} {{ horizontal_alignment }} {{ horizontal_text_alignment }} {{ horizontal_alignment_mobile }} {{ horizontal_position }} overflow-hidden spacing-style {% if block.settings.inherit_color_scheme == false %} color-{{ block.settings.color_scheme }} {% endif %} h-100"
  style="gap:{{ block.settings.grid_space }}px; {% render 'spacing-style', settings:block.settings %}"
  {{ block.shopify_attributes }}
>
  {% content_for 'block', type: 'icon', id: 'icon' %}
  <div class="content-section d-flex flex-column {{ align_content }} {{ align_content_mobile }} {{ text_alignment }} {{ text_alignment_mobile }} {{ horizontal_alignment_mobile }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:name.card",
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }],
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "t:settings.position",
      "options": [
        {
          "value": "start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vartical_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },

    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:settings.mobile_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "end",
          "label": "t:options.right"
        }
      ],
      "default": "center",
    },

    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.card",
      "settings": {
        "color_scheme": "scheme-3",
        "grid_space": 24
      },
      "blocks": [
        {
          "name": "t:settings.heading",
          "type": "text",
          "settings": {
            "text": "<h4>SpecificationHeading</h4>",
            "padding-block-end": 16
          }
        },
        {
          "name": "t:settings.description",
          "type": "description",
          "settings": {
            "text": "description",
            "padding-block-end": 16
          }
        }
      ]
    }
  ]
}
{% endschema %}
