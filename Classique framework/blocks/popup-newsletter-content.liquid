{% liquid
  assign direction = 'flex-column'
  assign horizontal_alignment = 'align-items-sm-' | append: block.settings.alignment
  assign horizontal_alignment_mobile = 'align-items-' | append: block.settings.alignment_mobile
  assign vertical_alignment = 'justify-content-center'
  assign text_alignment = 'text-sm-' | append: block.settings.alignment
  assign text_alignment_mobile = 'text-' | append: block.settings.alignment_mobile
%}
<div
  class="banner-content group-block border-style w-100 d-flex {{ direction }} {{ horizontal_alignment_mobile }} {{ horizontal_alignment }} {{ text_alignment }} {{ text_alignment_mobile }} {{ vertical_alignment }} spacing-style gap-style"
  style="
    --gap-style: max(calc(var(--space-scale, 1.0) * {{ block.settings.grid_space | default: 0 }}px));
    {% render 'spacing-style', settings:block.settings %}
     {% render 'border-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:name.content",
  "tag": null,
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "newsletter" },{"type": "header-social-icon"}],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "t:settings.mobile_alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "grid_space",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "t:settings.gap",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "t:name.content",
      "category": "t:categories.layout",
      "blocks": [
        {
          "type": "text",
          "name": "t:options:heading"
        },
        {
          "type": "description",
          "name": "t:settings.description"
        },
        {
          "type": "newsletter",
          "name": "t:settings.button"
        }
      ]
     
    }
  ]
}
{% endschema %}
