{%- if block.settings.blog_sidebar -%}
  {%- capture children -%}
     {%- render 'blog-sidebar',
       settings:block.settings,
       collection_item:block.settings.collection
      -%}
    {%- endcapture -%}
  <button
    class="facts__drawer d-block d-lg-none btn btn-primary"
    type="button"
    data-bs-toggle="offcanvas"
    data-bs-target="#filtersOffcanvas"
    aria-controls="filtersOffcanvas"
    tabindex="0"
  >
    {{ 'blogs.filter' | t }}
  </button>
  <div
    class="offcanvas offcanvas-start d-lg-none{% unless block.settings.sidebar_inherit_color_scheme %} color-{{ block.settings.sidebar_color_scheme }} {% else %} color-{{ settings.offcanvas_color_scheme }}{% endunless %} gradient"
    tabindex="-1"
    id="filtersOffcanvas"
    aria-labelledby="filtersOffcanvasLabel"
    data-canvas-type="mobile"
     {{ block.shopify_attributes }}
  >
    <div class="offcanvas-header border-bottom  justify-content-between">
      <h3 class="offcanvas-title" id="filtersOffcanvasLabel">{{ 'products.facets.filter_button' | t }}</h3>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">
        {% render 'cancel.svg' %}
      </button>
    </div>

    <div
      class="offcanvas-body blog-card spacing-style d-flex flex-column h-100 w-100"
      {{ block.shopify_attributes }}
      style="{% render 'border-style', settings: block.settings %} {% render 'spacing-style', settings: block.settings  %} gap:{{ block.settings.vertical_gap }}px"
    >
      {{ children }}
    </div>
  </div>
  {%- if block.settings.blog_search
    or block.settings.show_articles
    or block.settings.show_tags
    or block.settings.show_collection
    or block.settings.show_promo
  -%}
    <aside
      class="blog_sidebar d-none d-lg-block border-style{% if block.settings.sidebar_border == 'solid' %} p-lg-4 {% endif %} {% unless block.settings.sidebar_inherit_color_scheme %} color-{{ block.settings.sidebar_color_scheme }} p-lg-4 {% endunless %}"
      style="
          --border-width: {{ block.settings.sidebar_border_width }}px;
          --border-style: {{ block.settings.sidebar_border }};
          --border-color: rgba(var(--color-border), {{ block.settings.sidebar_border_opacity | divided_by: 100.0 }});
        {% if block.settings.sidebar_border == 'solid' or block.settings.sidebar_inherit_color_scheme != true %}
          --border-radius:{{ block.settings.sidebar_border_radius }}px;
          {% endif %}
      "
    >
      <div
        class="blog-card color-{{ block.settings.color_scheme }} spacing-style d-flex flex-column h-100 w-100"
        {{ block.shopify_attributes }}
        style="{% render 'spacing-style', settings: block.settings  %} gap:{{ block.settings.vertical_gap }}px"
      >
        {{ children }}
      </div>
    </aside>
  {%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "t:name.sidebar",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_sidebar",
      "label": "t:settings.blog_sidebar"
    },
    {
      "type": "header",
      "content": "t:content.appearance",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "sidebar_inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": false,
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "color_scheme",
      "id": "sidebar_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.sidebar_inherit_color_scheme == false and block.settings.blog_sidebar }}"
    },
    {
      "type": "select",
      "id": "sidebar_border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "range",
      "id": "sidebar_border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.sidebar_border != 'none' and block.settings.blog_sidebar }}"
    },
    {
      "type": "range",
      "id": "sidebar_border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.sidebar_border != 'none' and block.settings.blog_sidebar }}"
    },
    {
      "type": "range",
      "id": "sidebar_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.sidebar_inherit_color_scheme == false or block.settings.sidebar_border == 'solid' }}"
    },
    {
      "type": "header",
      "content": "t:content.search",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "blog_search",
      "label": "t:settings.preditive_search",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "header",
      "content": "t:content.article",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "show_articles",
      "label": "t:settings.show_articles",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "enable_article_title",
      "label": "t:settings.enable_heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_articles == true }}"
    },
    {
      "type": "text",
      "id": "article_title",
      "label": "t:settings.heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_articles == true and block.settings.enable_article_title == true }}"
    },
    {
      "type": "range",
      "id": "article_limit",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:settings.limit",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_articles == true }}"
    },
    {
      "type": "header",
      "content": "t:content.tag",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.show_tags",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "enable_tag_title",
      "label": "t:settings.enable_heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_tags == true }}"
    },
    {
      "type": "text",
      "id": "tags_title",
      "label": "t:settings.heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_tags == true and block.settings.enable_tag_title == true }}"
    },
    {
      "type": "header",
      "content": "t:content.collection",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "Show collection",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_title",
      "label": "t:settings.enable_heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },
    {
      "type": "text",
      "id": "collection_title",
      "label": "t:settings.heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.enable_collection_title == true }}"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.sidebar_collection"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.ratio",
      "options": [
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "adapt",
          "label": "t:options.adapt"
        }
      ],
      "default": "square",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },

    {
      "type": "range",
      "id": "collection_limit",
      "label": "t:settings.limit",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.collection != blank }}"
    },
    {
      "type": "select",
      "id": "alignment_collection",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.card_product_style",
      "options": [
        { "value": "on_image", "label": "t:options.on_image" },
        { "value": "card", "label": "t:options.card" }
      ],
      "default": "card",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },
    {
      "type": "checkbox",
      "id": "card_inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and  block.settings.card_style == 'card' }}"
    },
    {
      "type": "color_scheme",
      "id": "collection_color_scheme",
      "label": "t:settings.color_scheme",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.card_inherit_color_scheme == false and  block.settings.card_style == 'card' }}"
    },
    {
      "type": "select",
      "id": "card_border",
      "label": "t:settings.border",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },

    {
      "type": "range",
      "id": "card_border_width",
      "label": "t:settings.thickness",
      "min": 1,
      "max": 5,
      "unit": "px",
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.card_border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "card_border_opacity",
      "label": "t:settings.opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.card_border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true }}"
    },

    {
      "type": "select",
      "id": "style",
      "label": "t:settings.nav_style",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrow"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.collection != blank }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.style == 'arrow' and block.settings.show_collection == true }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.border != 'none' and block.settings.style == 'arrow' and block.settings.show_collection == true }}"
    },

    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.border != 'none'  and block.settings.style == 'arrow' and block.settings.show_collection == true}}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.style == 'arrow' and block.settings.show_collection == true }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_collection == true and block.settings.style == 'arrow' }}"
    },
    {
      "type": "color_scheme",
      "id": "pagination_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.style == 'arrow' and block.settings.show_collection == true and block.settings.inherit_color_scheme == false  }}"
    },
    {
      "type": "header",
      "content": "t:content.promo",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "t:settings.show_promo",
      "visible_if": "{{ block.settings.blog_sidebar }}"
    },
    {
      "type": "checkbox",
      "id": "enable_promo_title",
      "label": "t:settings.enable_heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "t:settings.heading",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true and block.settings.enable_promo_title == true }}"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "select",
      "id": "promo_border",
      "label": "t:settings.border",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "range",
      "id": "promo_border_width",
      "label": "t:settings.thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true and block.settings.promo_border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "promo_border_opacity",
      "label": "t:settings.opacity",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true and block.settings.promo_border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "promo_border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "header",
      "content": "t:name.button",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "text",
      "id": "promo_btn",
      "label": "t:settings.label",
      "default": "Shop now",
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "t:settings.link",
      "visible_if": "{{  block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_in_new_tab",
      "visible_if": "{{  block.settings.blog_sidebar and block.settings.show_promo == true }}"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "t:settings.style",
      "default": "btn-primary",
      "options": [
        {
          "value": "btn-primary",
          "label": "t:options.primary"
        },
        {
          "value": "btn-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "btn-link",
          "label": "t:options.link"
        }
      ],
      "visible_if": "{{ block.settings.blog_sidebar and block.settings.show_promo == true }}"
    }
  ]
}
{% endschema %}
