{% liquid

  assign alignment = block.settings.alignment
  
  case alignment
    when 'start'
      assign horizondal_alignment = 'justify-content-start align-items-start text-start'   
    when 'center'
      assign horizondal_alignment = 'justify-content-center align-items-center text-center'
    when 'end'
      assign horizondal_alignment = 'justify-content-end align-items-end text-end'
  endcase
%}


<div
  class=" spacing-style border-style {% if block.settings.inherit_color == false %}color-{{ block.settings.inherit_color_scheme }}{% endif %}"
  style="
    {% render 'spacing-style', settings: block.settings%}
    {% render 'border-style', settings: block.settings %}
     height: fit-content; width: fit-content;
  "{{ block.shopify_attributes }}
>
  <div class="p-2 d-flex flex-column gap-style {{ horizondal_alignment }}" style="--gap-style:max(calc(var(--space-scale) * {{ block.settings.grid_space }}px));">
  {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:name.deal-content",
  "tag": null,
  "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "button" }, { "type": "deal-timer" }],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 10,
      "unit": "px",
      "id": "grid_space",
      "label": "t:settings.gap"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "inherit_color_scheme",
      "label": "t:settings.color_scheme",
      "visible_if": "{{ block.settings.inherit_color == false }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:options.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:options.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:options.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:options.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:name.deal-content",
      "blocks": [{ "type": "text" }, { "type": "description" }, { "type": "deal-timer" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
