  {% if filter_layout == 'vertical' %}
  <!-- Vertical Filter -->
  <aside
  class="col-lg-4 col-xl-4  col-xxl-3{% if placement == "row" %} pe-xl-4 {% else %} ps-xl-4 {% endif %} {% if section.settings.full_width %}  {% endif %} sticky-lg-top h-100 text-wrap mb-sm-0 mb-3"
  id="main-collection-filters"
  data-id="{{ section.id }}"
  aria-labelledby="{{ filter_layout }}"
  style="{% render 'border-style', settings: block.settings %}
  {% if block.settings.border == 'solid' or block.settings.inherit_color_scheme != true %}
  --border-radius:{{ block.settings.border_radius }}px;
  {% endif %}"
  >
  <div
  id="{{ filter_layout }}"
  class="border-style {%  if block.settings.inherit_color_scheme %}color-{{ block.settings.filter_color_scheme }} {% endif %} {%  if block.settings.inherit_color_scheme or block.settings.border == 'solid' %} ps-lg-4 pe-lg-4 p-3 p-md-4 {% endif %} facets-wrapper {% unless section.settings.enable_filtering %} facets-wrapper--no-filters d-none{% endunless %}"
  >
  <!-- Active Filters  mobile -->
  {% render 'active-filters', show_active_filters: block.settings.show_active_filters, filters: filters %}
  <!-- Active Filters End -->
  {% render 'wdt-filter',
  results: collection,
  enable_filtering: section.settings.enable_filtering,
  enable_sorting: section.settings.enable_sorting,
  show_filter_count: block.settings.enable_filter_count,
  layout: 'vertical',
  collapse: block.settings.expand_panel,
  number_of_products: number_of_products,
  show_active_filters: block.settings.show_active_filters,
  %}
  </div>
  </aside>
  <!-- Vertical Filter End -->
  {% endif %}  


  {% if filter_layout == 'horizontal' and section.settings.enable_filtering %}
  <!-- Horizontal Filter -->
  <div id="{{ filter_layout }}" class="col-12"
  style="{% render 'border-style', settings: block.settings %}
  {% if block.settings.border == 'solid' or block.settings.inherit_color_scheme != true %}
  --border-radius:{{ block.settings.border_radius }}px;
  {% endif %}"
  >
  <div class="horizontal_wrapper border-style overflow-visible mb-3 {%  if block.settings.inherit_color_scheme %}color-{{ block.settings.filter_color_scheme }} {% endif %} {%  if block.settings.inherit_color_scheme or block.settings.border == 'solid' %} ps-lg-4 pe-lg-4 p-3 p-md-4 {% endif %}">
  <!-- Active Filters  mobile -->
  {% render 'active-filters', show_active_filters: block.settings.show_active_filters, filters: filters %}
  <!-- Active Filters End -->
  {% render 'wdt-filter',
  results: collection,
  enable_filtering: section.settings.enable_filtering,
  enable_sorting: section.settings.enable_sorting,
  show_filter_count: block.settings.enable_filter_count,
  layout: 'horizontal',
  number_of_products: number_of_products,
  show_active_filters: block.settings.show_active_filters
  %}
  </div>
  </div>
  <!-- Horizontal Filter End -->
  {% endif %} 
  {% if filter_layout == 'drawer' %} 
  <!-- Drawer Filter -->
  <div
  id="{{ filter_layout }}"
  class="facts__drawers  {% if collection.products.size == 0 %}d-none {% endif %} d-flex align-items-center w-100 mb-3  flex-wrap gap-4 {% if section.settings.enable_filtering == false %}justify-content-end{%else%}justify-content-sm-between{% endif %} "
  >
  {% if section.settings.enable_filtering %}
  <button
  class="btn btn-primary facts_buttons"
  data-bs-toggle="offcanvas"
  data-bs-target="#filtersOffcanvas"
  aria-controls="filtersOffcanvas"
  style="width:auto;"
  >
  {{ 'products.facets.filter_button' | t }}
  </button>
  {% endif %}
  <!-- Sorting and product count -->

  <facet-filters-form class="facets facets-vertical-sort d-flex align-items-center gap-3 d-none d-sm-flex">
  {% if section.settings.enable_product_count  %}
  <div class="number-of-products-count">
  {{ 'products.product.count' | t: count: collection.products_count }}
  </div>
  {%endif%}
  {% if  section.settings.enable_sorting %}
  <form class="facets-vertical-form " id="FacetSortForm">
  {%- if section.settings.enable_sorting and collection.products.size != 0 -%}
  <div class="facet-filters sorting caption w-100  d-block">
  <div class="facet-filters__field d-flex align-items-center flex-wrap justify-content-center gap-2">
  <div class="select">
  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
  <!-- Visual ul li List -->
  {%- liquid
  for option in collection.sort_options
  if option.value == sort_by
  assign primary_choice = option.name | escape
  endif
  endfor
  %}
  <product-sorting class="sort-by dropdown">
  <button
  class="custom-select-buttons border  dropdown-toggle btn btn-secondary ps-4 pe-5 "
  type="button"
  id="dropdownMenuSorting"
  data-bs-toggle="dropdown"
  aria-expanded="false"
  >
  {{ primary_choice }}
  <!-- Add the SVG Arrow icon here -->
  </button>

  <ul
  class="sort-options dropdown-menu dropdown-menu-light wdt-custom-sorting"
  aria-labelledby="dropdownMenuSorting"
  role="menu"
  >
  {%- for option in collection.sort_options -%}
  <li
  data-value="{{ option.value | escape }}"
  role="menuitem"
  tabindex="0"
  {% if option.value == sort_by %}
  class="selected"
  {% endif %}
  >
  <input
  type="radio"
  class="visually-hidden"
  name="sort_by"
  id="sort-by-{{ option.value }}"
  value="{{ option.value }}"
  {% if option.value == sort_by %}
  checked
  {% endif %}
  >
  <label
  class="dropdown-item dropdown-item btn btn-secondary"
  for="sort-by-{{ option.value }}"
  >
  <span>
  {{ option.name | escape }}
  </span>
  </label>
  </li>
  {%- endfor -%}
  </ul>
  </product-sorting>
  </div>
  </div>
  </div>
  {% endif %}
  </form>
  {% if section.settings.enable_product_count and collection.products.size != 0 %}
  {% endif %}
  {% endif %}
  </facet-filters-form>


  </div>
  <div
  class="offcanvas offcanvas-start filter_layout-drawer filter_layout-canvas-triggered color-{{ block.settings.filter_color_scheme }} gradient p-0"
  tabindex="-1"
  id="filtersOffcanvas"
  aria-labelledby="filtersOffcanvasLabel"
  data-canvas-type="desktop"
  >
  <div class="offcanvas-header border-bottom  justify-content-between">
  <h3 class="offcanvas-title" id="filtersOffcanvasLabel">{{ 'products.facets.filter_button' | t }}</h3>
  <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close">{% render 'cancel.svg' %}</button>
  </div>

  <div class="offcanvas-body">
  {% render 'wdt-filter',
  results: collection,
  enable_filtering: section.settings.enable_filtering,
  enable_sorting: section.settings.enable_sorting,
  show_filter_count: block.settings.enable_filter_count,
  layout: 'drawer',
  collapse: block.settings.expand_panel,
  number_of_products: number_of_products,
  show_active_filters: block.settings.show_active_filters,
  filter_layout: section.settings.filter_layout
  %}
  </div>
  </div>
  <!-- Drawer Filter End -->
  {% endif %}  
{% schema %}
{
  "name": "t:name.fillter_sorting",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "expand_panel",
      "default": false,
      "label": "t:settings.expand_panel",
      "info": "t:info.expand_panel",
    },
    {
      "type": "checkbox",
      "id": "enable_filter_count",
      "default": true,
      "label": "t:settings.enable_filter_count",
    },
    {
      "type": "checkbox",
      "id": "show_active_filters",
      "default": true,
      "label": "t:settings.show_active_filters",
    },
    {
      "type": "header",
      "content": "t:content.appearance",
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": false,
    },
    {
      "type": "color_scheme",
      "id": "filter_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == true }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none",
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
     {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.inherit_color_scheme == true or block.settings.border == 'solid' }}"
    }
  ]
}
{% endschema %}