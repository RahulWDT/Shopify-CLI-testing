<div id="compareModal" class="modal fade alert-overlay" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <div class="modal-header align-items-baseline">
        <h2 class="modal-title h5 text-center">{{ 'products.compare.limit_warning' | t }}</h2>
        <button type="button" id="compareModalClose" class="btn-close position-absolute top-0 end-0 m-2" data-bs-dismiss="modal" aria-label="Close">{% render 'cancel.svg' %}</button>
      </div>
      <div class="modal-body text-center px-0">
        <p my-3>{{ 'products.compare.limit' | t }}</p>
        <a href="/pages/compare" class="button btn btn-primary">{{ 'products.compare.view_compare' | t }}</a>
      </div>
    </div>
  </div>
</div>
