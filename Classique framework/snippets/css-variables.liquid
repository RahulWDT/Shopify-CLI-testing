} */

 .article-share button{
   font-size: var(--bs-font-h4-size);
 }
.article_tag{
    --bs-btn-padding-x: 0.2rem !important;
    --bs-btn-padding-y: 0.2rem !important;
  }
  
  .details > *{ position:relative; }
 .details > *:not(:last-child)::after {
    content: '';
    position: absolute;
    width: 1px;
    height: 100%;
    background: rgba(var(--color-foreground));
    right: -9px;
    top: 0;
    bottom: 0;
}


/*Card icons*/
  .product_card_icons .wishlist_button .add-wishlist:before,
  .product_card_icons .compare_button .add-compare:before{
  content:"";
  width:18px;
  height:18px;
  display:block;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  -webkit-mask-position: center;
  }
  .product_card_icons button.quick-view-btn {
  width: 40px;
  height: 40px;
  background: rgb(var(--color-primary-button-bg));
  color: rgb(var(--color-primary-button-text));
  fill:rgb(var(--color-primary-button-text));
  border:none;
  border-radius:50%;
  font-size:20px;
  display: flex;
  justify-content: center;
  align-items: center;
  border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-border));
  }
  .product_card_icons .wishlist_button,
  .product_card_icons .compare_button {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--color-primary-button-bg));
  border-radius: 50%;
  border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-border));
  }
  .product_card_icons :is(.wishlist_button, .compare_button), 
  .product_card_icons button.quick-view-btn, 
  .product_card_icons :is(.wishlist_button a, .compare_button a){
    transition: all .3s linear;
  }
  .product_card_icons :is(.wishlist_button, .compare_button):hover{
     background: rgb(var(--color-primary-button-hover-bg));
     border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-hover-border));
  }
  .product_card_icons :is(.wishlist_button:hover a, .compare_button:hover a){
     color: rgb(var(--color-primary-button-hover-text));
  }
  .product_card_icons button.quick-view-btn:hover{
     background: rgb(var(--color-primary-button-hover-bg));
     color: rgb(var(--color-primary-button-hover-text));
     border: var(--bs-primary-thickness) solid rgb(var(--color-primary-button-hover-border));
  }
  .product_card_icons .wishlist_button .add-wishlist,
  .product_card_icons .compare_button .add-compare{
  color: rgb(var(--color-primary-button-text));
  } 
  .product_card_icons .wishlist_button a.adding:before,
  .product_card_icons .compare_button a.adding:before{
  width: 20px;
  height: 20px;
  border: 2px solid rgb(var(--color-primary-button-text));
  border-left-color: rgb(var(--color-primary-button-bg));
  border-radius: 50%;
  animation: spin 1s linear infinite; 
  }
  @keyframes spin {
  to { transform: rotate(360deg); }
  }
