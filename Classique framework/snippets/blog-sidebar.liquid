{% liquid
  assign aspect_ratio = ''
  case settings.aspect_ratio
    when 'square'
      assign aspect_ratio = 'ratio-1x1'
    when 'portrait'
      assign aspect_ratio = 'ratio-3x4'
    when 'landscape'
      assign aspect_ratio = 'ratio-4x3'
    when 'adapt'
      assign aspect_ratio = 'ratio-auto'
    else
      assign aspect_ratio = 'ratio-1x1'
  endcase

  assign product = closest.product

  if settings.alignment_collection == 'start'
    assign text_alignment = 'justify-content-start text-start'
  elsif settings.alignment_collection == 'center'
    assign text_alignment = 'justify-content-center text-center'
  else
    assign text_alignment = 'justify-content-end text-end'
  endif
%}

{% style %}
    .categories li, .article-image img {
      border-radius: var(--bs-border-radius);
    }
  {% if settings.promo_border == 'solid' %}
    .promo_img {
      border:  {{ settings.promo_border_width }}px solid rgba(var(--color-border), {{ settings.promo_border_opacity | divided_by: 100.0 }});
    }
  {%endif %}
  .promo_img {
    border-radius: {{ settings.promo_border_radius }}px;
  }


{% endstyle %}




    {%- if settings.blog_search -%}
      <predictive-search class="search-modal__form pb-4" data-loading-text="{{ 'accessibility.loading' | t }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field position-relative">
            <input
              class="search__input field__input form-control"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              {%- if settings.blog_search -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="field__label d-none" for="{{ input_id }}">
              {{ 'general.search.search' | t }}
            </label>

            <input type="hidden" name="options[prefix]" value="last">

            <button
              type="reset"
              class="position-absolute top-50 reset__button field__button{% if search.terms == blank %} visually-hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              {% render 'icon-close' %}
            </button>

            <button
              class="search__button field__button position-absolute top-0 bottom-0 m-auto border-0 bg-transparent d-flex align-items-center gap-2 p-2"
              aria-label="{{ 'general.search.search' | t }}"
            >
              {% render 'icon-search' %}
            </button>
          </div>
          <div
            class="predictive-search rounded-3 p-3 position-absolute predictive-search--header"
            tabindex="-1"
            data-predictive-search
            style="z-index: 100; left: 20px; "
          >
            <div class="predictive-search__loading-state">
              <svg
                aria-hidden="true"
                focusable="false"
                class="spinner"
                viewBox="0 0 66 66"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
              </svg>
            </div>
          </div>
          <span class="predictive-search-status visually-hidden py-3" role="status" aria-hidden="true"></span>
        </form>
      </predictive-search>
    {%- endif -%}


    {%- if settings.show_articles -%}
      <div class="widget-articles pb-4">
        {% if settings.enable_article_title %}
          {% if settings.article_title != blank %}
            <h5 class="sidebar_title h5 mb-3">{{ settings.article_title }}</h5>
          {% else %}
            <h5 class="sidebar_title h5 mb-3">{{ 'blogs.article.article' | t }}</h5>
          {% endif %}
        {% endif %}


        <div class="blog-sidebar-panel">
          <ul class="recent_article p-0">
            {% for article in blogs[blog.handle].articles limit: settings.article_limit %}
              <li class="article-item">
                <div class="article-image">
                    {% if article.image %}
                    <a href="{{ article.url }}">
                      <img
                        srcset="
                          {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                          {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                          {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                          {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                          {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                          {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                          {{ article.image | image_url }} {{ article.image.width }}w
                        "
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                        src="{{ article.image | image_url: width: 1100 }}"
                        loading="lazy"
                        width="{{ article.image.width }}"
                        height="{{ article.image.height }}"
                        class="w-100 h-100 object-fit-cover"
                        alt="{{ article.image.alt | escape }}"
                      >
                    </a>
                  {% else %}
                    <img src="{{ 'image_placeholder.jpg' | asset_url }}" class="placeholder-svg" alt="blog_placeholder">
                  {% endif %}
                  </div>
                <div class="article-description">
                  <div class="divider mb-1">{{ article.published_at | date: '%b %d' }}</div>
                  <h5 class="article-title m-0 h6">
                    <a href="{{ article.url }}">{{ article.title | truncate: 40 }}</a>
                  </h5>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {%- endif -%}


    {%- if settings.show_tags -%}
      <div class="widget-tags pb-4">
        {% if settings.enable_tag_title %}
          {% if settings.tags_title != blank %}
            <h5 class="sidebar_title h5 mb-3">{{ settings.tags_title }}</h5>
          {% else %}
            <h5 class="sidebar_title h5 mb-3">{{ 'blogs.article.tag' | t }}</h5>
          {% endif %}
        {% endif %}


        <div class="blog-sidebar-panel">
          <ul class="tag-container categories list-unstyled d-flex flex-wrap gap-2">
            {% for tag in blog.all_tags limit: settings.limit %}
              {% if current_tags contains tag %}
                <li class="active tag">{{ tag | link_to_tag: tag }}</li>
              {% else %}
                <li class="tag">{{ tag | link_to_tag: tag }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>
    {%- endif -%}


    {%- if settings.show_collection -%}
      
        <div class="collection_block pb-4">
          
          {% if settings.enable_collection_title %}
          <h5 class="mb-3 sidebar_title h5">
          {{ settings.collection_title | default: collection_item.title }}
          </h5>
          {% endif %}

          <wdt-collection-sidebar>
            <div
              data-slider-options='
                        {
                  "desktop": "1",
                  "laptop": "1",
                  "tablet": "1",
                  "mobile": "1",
                  "loop": "false",
                  "mode": "false",
                  "auto_play": "false",
                  "space": "20"
                }
              '
            >
              <div class="product-carousel swiper position-relative" data-swiper-slider>
                <div class="product-carousel-wrapper swiper-wrapper">
                  {% for product in settings.collection.products limit: settings.collection_limit %}
                    {% assign card_product = product %}
                    <div class="swiper-slide h-auto desk-{{ slider_desktop }} laptop-{{ slider_laptop }} tablet-{{ slider_tablet }} mobile-{{ slider_mobile }}">
                      {% assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id %}
                      <div class="card-wrapper product-card-wrapper h-100">
                        <div
                          class="card-main h-100 card overflow-hidden {% if settings.card_inherit_color_scheme == false and settings.card_style != 'on_image' %}color-{{ settings.collection_color_scheme }}{% endif %} gradient"
                          {% if settings.card_style == 'card' %}
                            style="
                              border-width: {{ settings.card_border_width }}px;
                              border-style: {{ settings.card_border }};
                              border-color: rgba(var(--color-border), {{ settings.card_border_opacity | divided_by: 100.0 }});
                              border-radius:{{ settings.card_border_radius }}px;
                               {% if card_product.media.aspect_ratio == null %}
                                     --aspect-ratio:100%;
                                     {% else %}
                                    --aspect-ratio:{%- if card_product.media -%}{{ 1 | divided_by: card_product.media.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};
                                    {% endif %}
                            "
                          {% endif %}
                        >
                          <div
                            class="card__inner overflow-hidden position-relative ratio {{ aspect_ratio }}"

                            {% if settings.card_style == 'on_image' %}
                              style="
                                border-width: {{ settings.card_border_width }}px;
                                border-style: {{ settings.card_border }};
                                border-color: rgba(var(--color-border), {{ settings.card_border_opacity | divided_by: 100.0 }});
                                border-radius:{{ settings.card_border_radius }}px;
                                 {% if card_product.media.aspect_ratio == null %}
                                     --aspect-ratio:100%;
                                     {% else %}
                                    --aspect-ratio:{%- if card_product.media -%}{{ 1 | divided_by: card_product.media.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};
                                    {% endif %}
                              "
                            {% endif %}
                          >
                            <div class="card__inner_wrapper">
                              {%- if card_product.featured_media -%}
                                <a href="{{ card_product.url }}" class="card--image">
                                  {{
                                    card_product.featured_media
                                    | image_url: width: 1280
                                    | image_tag:
                                      loading: 'lazy',
                                      width: card_product.featured_media.width,
                                      height: card_product.featured_media.height,
                                      sizes: '(min-width: 1200px) 600px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                                      widths: '540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                                      class: 'motion-reduce featured-media',
                                      alt: card_product.featured_media.alt
                                    | escape
                                  }}

                                  {%- if card_product.media[1] != null and show_secondary_image -%}
                                    <span class="card-secondary-image overflow-hidden">
                                      {{
                                        card_product.media[1]
                                        | image_url: width: 1280
                                        | image_tag:
                                          alt: card_product.media[1].alt,
                                          aria_hidden: 'true',
                                          loading: 'lazy',
                                          width: card_product.media[1].width,
                                          height: card_product.media[1].height,
                                          sizes: '(min-width: 1200px) 600px, (min-width: 992px) calc((100vw - 130px) / 3), (min-width: 768px) calc((100vw - 120px) / 2), calc((100vw - 35px) / 2)',
                                          widths: '540, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946',
                                          class: 'motion-reduce'
                                        | escape
                                      }}
                                    </span>
                                  {%- endif -%}
                                </a>
                              {% else %}
                                <img
                                  src="{{ 'product_placeholder.jpg' | asset_url }}"
                                  class="placeholder h-100 w-100"
                                  alt="product_placeholder"
                                >
                              {%- endif -%}

                              <div class="product_card_icons z-3">
                                {% if enable_wishlist %}
                                  {% render 'button-wishlist' %}
                                {% endif %}

                                {% if enable_compare %}
                                  {% render 'button-compare' %}
                                {% endif %}

                                {% if enable_quickview %}
                                  {% render 'quick-add-button' %}
                                {% endif %}
                              </div>
                            </div>
                            <div class="card_content">
                              {%- if card_product.available == false -%}
                                <span
                                  id="Badge-{{ section_id }}-{{ card_product.id }}"
                                  class="badge badge--bottom-left h6 sold_out_badge"
                                >
                                  {{- 'products.product.sold_out' | t -}}
                                </span>
                              {%- elsif card_product.compare_at_price > card_product.price
                                and card_product.available
                              -%}
                                <span
                                  id="Badge-{{ section_id }}-{{ card_product.id }}"
                                  class="badge badge--bottom-left h6 sale_badge"
                                >
                                  {{- 'products.product.on_sale' | t -}}
                                </span>
                              {%- endif -%}
                            </div>
                          </div>
                          <div class="card-body {{ text_alignment }} {% if settings.card_style == 'card' %}p-3{% else %} px-0 py-3{% endif %}">
                            <div class="card-body-information">
                              <h3 class="card-title h6" id="title-{{ section_id }}-{{ card_product.id }}">
                                <a
                                  href="{{ card_product.url }}"
                                  id="CardLink-{{ section_id }}-{{ card_product.id }}"
                                  aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }}"
                                >
                                  {{ card_product.title | escape }}
                                </a>
                              </h3>
                              {% render 'price',
                                product: card_product,
                                price_class: '',
                                show_compare_at_price: true,
                                text_align: text_alignment
                              %}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% else %}
                    {% for i in (1..section.settings.collection_limit) %}
                      <div class="swiper-slide h-auto desk-{{ slider_desktop }} laptop-{{ slider_laptop }} tablet-{{ slider_tablet }} mobile-{{ slider_mobile }}">
                        <div class="card-wrapper product-card-wrapper">
                          <div
                            class="card card-main h-100 overflow-hidden {% if settings.card_inherit_color_scheme == false and settings.card_style != 'on_image' %}color-{{ settings.collection_color_scheme }}{% endif %}"
                            {% if settings.card_style == 'card' %}
                              style="
                                border-width: {{ settings.card_border_width }}px;
                                border-style: {{ settings.card_border }};
                                border-color: rgba(var(--color-border), {{ settings.card_border_opacity | divided_by: 100.0 }});
                                border-radius:{{ settings.card_border_radius }}px;
                                 {% if card_product.media.aspect_ratio == null %}
                                     --aspect-ratio:100%;
                                     {% else %}
                                    --aspect-ratio:{%- if card_product.media -%}{{ 1 | divided_by: card_product.media.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};
                                    {% endif %}
                              "
                            {% endif %}
                          >
                            <div
                              class="card__inner overflow-hidden position-relative ratio {{ aspect_ratio }} color-{{ card_background }} gradient"
                              {% if settings.card_style == 'on_image' %}
                                style="
                                  border-width: {{ settings.card_border_width }}px;
                                  border-style: {{ settings.card_border }};
                                  border-color: rgba(var(--color-border), {{ settings.card_border_opacity | divided_by: 100.0 }});
                                  border-radius:{{ settings.card_border_radius }}px;
                                  {% if card_product.media.aspect_ratio == null %}
                                   --aspect-ratio:100%;
                                   {% else %}
                                  --aspect-ratio:{%- if card_product.media -%}{{ 1 | divided_by: card_product.media.aspect_ratio | times: 100 }}% {%- else -%} 100% {%- endif -%};
                                  {% endif %}
                                "
                              {% endif %}
                            >
                              <div class="card__inner_wrapper">
                                {%- if placeholder_image -%}
                                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                                {%- else -%}
                                  {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
                                {% endif %}
                              </div>
                            </div>
                            <div class="card-body {{ text_alignment }} {% if settings.card_style == 'card' %}p-3{% else %} px-0 py-3{% endif %}">
                              <div class="card-body-information">
                                <h3 class="card-title h6" id="title-{{ section_id }}-{{ card_product.id }}">
                                  <a role="link" aria-disabled="true" class="full-unstyled-link">
                                    {{ 'onboarding.product_title' | t }}
                                  </a>
                                </h3>
                                <div class="placeholder-price">{{ 0.00 | money }}</div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  {% endfor %}
                </div>
                  {%- if settings.style == 'arrow' -%}
                    <div class="swiper-navigation">
                  <div
                  id="swiper-sidebar-prev" 
                  tabindex="0"
                  class="navigation_button swiper-button-prev  border-style  {% if settings.inherit_color_scheme == false %}color-{{ settings.pagination_color_scheme }}{% endif %}"
                  type="button"
                  title="Prev"
                  style="
                  --border-width: {{ settings.border_width }}px;  --border-style: {{ settings.border }};  --border-radius: {{ settings.border_radius }}px;
                  --border-color:rgba(var(--bs-border-color),{{ settings.border_opacity | divided_by: 100.0 }});
                  "
                  >
                  {% render 'left-arrow' %}
                  </div>
                  <div
                 id="swiper-sidebar-next"    
                  tabindex="0"
                  class="navigation_button swiper-button-next  border-style  {% if settings.inherit_color_scheme == false %}color-{{ settings.pagination_color_scheme }}{% endif %} "
                  type="button"
                  title="Next"
                  style="
                  --border-width: {{ settings.border_width }}px;  --border-style: {{ settings.border }};  --border-radius: {{ settings.border_radius }}px;
                  --border-color:rgba(var(--bs-border-color),{{ settings.border_opacity | divided_by: 100.0 }});
                  "
                  >
                  {% render 'right-arrow' %}
                  </div>
                  </div>
                  {%- endif -%}
                  
                  {%- if settings.style == 'dots' -%}
                  <div class="swiper-pagination mx-auto"></div>
                  {%- endif -%}

              </div>
            </div>
          </wdt-collection-sidebar>
        </div>
      {%- endif -%}



    {%- if settings.show_promo -%}
      <div class="promo-banner d-flex flex-column align-items-center position-relative">

        {% if settings.enable_promo_title  %}
          {% if settings.promo_title != blank %}
            <h5 class="text-start h5 w-100 mb-3">{{ settings.promo_title }}</h5>
          {% else %}
            <h5 class="text-start h5 w-100 mb-3">{{ 'blogs.article.promo' | t }}</h5>
          {% endif %}
        {% endif %}


        {% if settings.promo_image != blank %}
          <img
            src="{{ settings.promo_image | image_url: width: 1200 }}"
            alt="{{ settings.promo_image.alt | escape }}"
            loading="lazy"
            class="w-100 h-auto promo_img"
          >

        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
         {% if settings.promo_btn != blank  %}
            <div class="position-absolute bottom-0 start-0 end-0 w-fit m-auto mb-3">
              <a
                {% if settings.promo_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ settings.promo_link }}"
                {% endif %}
                class="btn {{ settings.btn_style }} {% if settings.btn_animation %}d-inline-flex align-items-center justify-content-center gap-3 position-relative btn-hover-animate hover-animate {% endif %}"
                {%- if settings.open_in_new_tab -%}
                  target="_blank" rel="noopener noreferrer"
                {%- endif -%}
              >
                <span>{{ settings.promo_btn }} </span>
                {% if settings.btn_animation -%}
                  <span class="btn-arrow"> {% render 'btn-arrow' %}</span>
                {%- endif %}
              </a>
            </div>
          {% endif %}
      </div>
    {%- endif -%}




