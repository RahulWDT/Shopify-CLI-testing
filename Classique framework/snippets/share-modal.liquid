<style>
   .modal-body .modal-link .btn svg{color:rgb(var(--color-foreground)); font-size: var(--bs-font-h4-size);}
   .modal-dialog .modal-content .modal-body .modal-link button{ transition:all .3s linear; width:50px; height:50px;}
   #shareModal .alert-success svg { width: 16px;}
     #shareModal #successMessage { margin-top: 0;  align-items: center; display: flex; justify-content: center; gap: 5px;}
   @media screen and (min-width: 576px) {
     .modal .modal-body .form-control {padding-right:8rem; padding-left:1rem;}
   }
  @media screen and (max-width: 576px) {
      .modal-dialog .input-group{ flex-direction:column;}
      .modal-dialog .input-group .form-control{width:100%;}
      .modal-dialog #copyButton{    display: flex; justify-content: center;  margin: auto;}
   }
  div#shareModal.show {overflow:hidden;}
</style>

<div
  class="modal fade"
  id="shareModal"
  tabindex="-1"
  aria-labelledby="shareModalLabel"
  aria-hidden="true"
  {{ block.shopify_attributes }}
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content color-{{ settings.offcanvas_color_scheme }} gradient m-2  px-3 py-4 px-sm-4 py-sm-5  border shadow rounded-4">
      <button
        type="button"
        class="btn-close m-2 m-sm-3    position-absolute top-0 end-0 z-1"
        data-bs-dismiss="modal"
        aria-label="Close"
      ></button>
      {%- if share_title != blank -%}
        <div class="modal-header border-0 p-0 mt-3 mt-sm-0 mb-4 justify-content-center justify-content-sm-start">
          <h4 id="shareModalLabel" class="mb-0 ">{{ share_title }}</h4>
        </div>
      {%- endif -%}
      <div class="modal-body p-0">
        <div class="input-group mb-2 gap-3">
          <input
            type="text"
            id="productUrl-{{ section.id }}"
            class="productUrl form-control w-100  mr-2 "
            value="{{ share_link  }}"
            readonly
          >
          <label for="productUrl-{{ section.id }}" class="visually-hidden">{{ share_title }}</label>
          <button
            class="position-sm-absolute end-0 top-0 bottom-0 m-auto  btn btn-primary d-flex align-items-center gap-2 shadow-none"
            type="button"
            id="copyButton"
          >
            {{ 'general.share.copy' | t }}
          </button>
        </div>
        <div
          id="successMessage"
          class="alert alert-success bg-body text-center mb-3 p-0"
          role="alert"
          style="display: none;"
        >
          {% render 'icon-copy' %}
          {{ 'general.share.success_message' | t }}
        </div>
        <div class="d-flex flex-wrap justify-content-center justify-content-sm-start  gap-3 modal-link mt-4">
          <!-- Facebook Share Button -->
          <button
            onclick="window.open('https://www.facebook.com/sharer/sharer.php?u='+encodeURIComponent(location.href), 'facebook-share-dialog', 'width=436,height=436'); return false;"
            aria-label="{{ 'general.social.links.facebook' | t }}"
            title="{{ 'general.social.links.facebook' | t }}"
            class="border rounded-1 d-flex align-items-center justify-content-center p-2 btn btn-secondary"
          >
            {%- render 'icon-facebook', class: 'overflow-visible' -%}
          </button>

          <!-- Twitter Share Button -->
          <button
            onclick="window.open('http://twitter.com/home/?status='+encodeURIComponent(location.href), 'twitter-share-dialog', 'width=436,height=436'); return false;"
            aria-label="{{ 'general.social.links.twitter' | t }}"
            title="{{ 'general.social.links.twitter' | t }}"
            class="border rounded-1 d-flex align-items-center justify-content-center p-2 btn btn-secondary"
          >
            {%- render 'icon-twitter', class: 'overflow-visible' -%}
          </button>

          <!-- Pinterest Share Button -->
          <button
            onclick="window.open('http://pinterest.com/pin/create/button/?url='+encodeURIComponent(location.href), 'pinterest-share-dialog', 'width=436,height=436'); return false;"
            aria-label="{{ 'general.social.links.pinterest' | t }}"
            title="{{ 'general.social.links.pinterest' | t }}"
            class="border rounded-1 d-flex align-items-center justify-content-center p-2 btn btn-secondary"
          >
            {%- render 'icon-pinterest', class: 'overflow-visible' -%}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
