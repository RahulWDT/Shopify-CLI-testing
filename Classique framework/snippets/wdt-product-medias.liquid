{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '300, 450, 600, 750, 900, 1050, 1200, 1350, 1500, 1650, 1800, 1950, 2000, 2500, 3000, 3500, 4000, 5000'
%}
<!-- Swiper container -->
{% assign selected_variant = product.selected_or_first_available_variant %}

{% if selected_variant %}
    {% for media in product.media %}
        {% if media.id == selected_variant.featured_media.id %}
           {% assign first_available_media = media.id %}
        {% endif %}
    {% endfor %}
{% endif %}


<wdt-main-media class="{{ direction }}" data-selected-variant-id="{{ first_available_media }}" data-section="{{ section.id }}" data-main-gallery-id="{{section.id}}">   
  <div class="swiper swiper-container product-media-gallery {% if style == 'none' %} mb-3 {% endif %}" tabindex="0">
    {% if promo_tag %}
      <div class="promo_tag badge product_new_badge position-absolute z-3" style="border-radius:{{ badge_radius }}px; text-transform:{{ badge_text }};">
        {{ promo_tag }}
      </div>
    {% endif %}
    <div class="swiper-wrapper product__media-list">
      {% if product.media.size == 0 %}
          <div class="swiper-slide media-child "           
          style="--aspect-ratio:100%"
          tabindex="0">
       {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg border rounded-4 h-100' }} 
          </div>
     {% else %}
      {% for media in product.media %}
        <div class="swiper-slide media-child media-type-{{ media.media_type }}" 
          data-media-id="{{ media.id }}" 
          media-type-is-{{ media.media_type }} 
          style="--aspect-ratio:{{ 1 | divided_by: media.aspect_ratio | times: 100 }}%"
          tabindex="0">
          {%- case media.media_type -%}
            {% when 'image' %}
            {%  assign media_height = 1024 | divided_by: media.preview_image.aspect_ratio | ceil %}
              {%- if section.settings.gallery_options == 'photoswipe_lightbox' -%}
                <a
                  href="{{ media | image_url: width: 3840 }}"
                  data-pswp-width="{{ media.width }}"
                  data-pswp-height="{{ media.height }}"
                  data-cropped="true"
                  target="_blank"
                >
                  
                  {%- if media.position == 1 -%}
                    {{
                      media
                      | image_url: width: 1024 
                      | image_tag:                                               
                        sizes: sizes,
                        widths: widths
                    }}
                  {%- else -%}
                    {{
                      media
                      | image_url: width: 1024 
                      | image_tag:                        
                        loading: 'lazy',
                        sizes: sizes,
                        widths: widths
                    }}
                  {%- endif -%}
                </a>
              {% endif %}
              {%- if section.settings.gallery_options == 'inner_zoom' -%}
                {% assign image_path = media | image_url: width: 1024 %}
                {%- if media.position == 1 -%}
                  {{
                    media.preview_image
                    | image_url: width: 1024
                    | image_tag:                      
                      class: 'magnify-zoom',
                      data-magnify-src: image_path,                     
                      sizes: sizes,
                      widths: widths
                  }}
                {%- else -%}
                  {{
                    media.preview_image
                    | image_url: width: 1024
                    | image_tag:                      
                      class: 'magnify-zoom',
                      data-magnify-src: image_path,
                      loading: 'lazy',
                      sizes: sizes,
                      widths: widths
                  }}
                {%- endif -%}
              {% endif %}
              {%- if section.settings.gallery_options == 'none' -%}
                {%- if media.position == 1 -%}
                  {{
                    media
                    | image_url: width: 1024
                    | image_tag: sizes: sizes, widths: widths
                  }}
                {%- else -%}
                  {{ media 
                  | image_url: width: 1024
                  | image_tag:  loading: 'lazy', sizes: sizes, widths: widths }}
                {%- endif -%}
              {% endif %}

            {% when 'video' %}
           {%  assign media_height = 1024  | divided_by: media.preview_image.aspect_ratio | ceil %}
              <!-- Trigger the Bootstrap modal for video -->
              <div class="product_media product-internal-video product-active-media"  style="--aspect-ratio: {{ media.aspect_ratio }}">
                <div class="product_media_preview">
                  <div class="preview_img loaded" >
                    {{ media.preview_image 
                    | image_url: width: 1024 
                    | image_tag: loading: 'lazy' }}
                  </div>
                      <div class="thumbnail__icon" 
                       tabindex="0" 
                       role="button" 
                       aria-label="Play video"
                       data-media-id="{{ media.id }}">                     
                  {%- render 'icon-play' -%}
                     </div>
                </div>
                <div class="product-video_main" style="--aspect-ratio: {{ media.aspect_ratio }}">
                  {{
                    media
                    | video_tag:
                      image_size: '1024x',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: true,
                      preload: 'none'
                  }}
                </div>
              </div>
            {% when 'external_video' %}
               {%  assign media_height = 1024  | divided_by: media.preview_image.aspect_ratio | ceil %}
              <!-- Trigger the Bootstrap modal for external video -->
              <div class="product_media product-external-video product-active-media"  style="--aspect-ratio: {{ media.aspect_ratio }}">
                <div class="product_media_preview">
                  <div class="preview_img" >
                    {{ media.preview_image 
                    | image_url: width: 1024
                    | image_tag: loading: 'lazy' }}
                  </div>
                    <div class="thumbnail__icon" 
                       tabindex="0" 
                       role="button" 
                       aria-label="Play video"
                       data-media-id="{{ media.id }}">                     
                  {%- render 'icon-play' -%}
                     </div>
                </div>
                <div class="product-video_main" style="--aspect-ratio: {{ media.aspect_ratio }}">
                  {%- liquid
                     assign video_class = 'js-' | append: media.host
                    if media.host == 'youtube'                   
                      echo media | external_video_url: autoplay: false, loop: true, playlist: media.external_id | external_video_tag: class: video_class, loading: 'lazy'
                    else
                      echo media | external_video_url: autoplay: false, loop: true | external_video_tag: loading: 'lazy'
                    endif
                  %}
                </div>
              </div>
            {% when 'model' %}
             {%  assign media_height = 1024  | divided_by: media.preview_image.aspect_ratio | ceil %}
              <product-model>
                <div class="product_media product-3d-modal product-active-media">
                  <div class="product-3d-model__preview product_media_preview">
                    <div class="preview_img">
                      {{ media.preview_image | image_url: width: 1024, height: media_height  | image_tag: loading: 'lazy' }}
                    </div>
                   <div class="thumbnail__icon" 
                       tabindex="0" 
                       role="button" 
                       aria-label="View 3D model"
                       data-media-id="{{ media.id }}">                     
                        {% render 'icon-3d-model' %}
                     </div>                  
                  </div>
                  <div class="product-3d-model__main product-video_main rounded-5 overflow-hidden" style="--aspect-ratio: {{ media.aspect_ratio }}">
                    {{ media | model_viewer_tag: interaction-policy: 'allow-when-focused'  }}
                  </div>

                  <button
                    class="model-viewer-button"
                    type="button"
                    aria-label="{{ 'products.product.xr_button_label' | t }}"
                    data-shopify-xr
                    data-shopify-model3d-id="{{ media.id }}"
                    data-shopify-title="{{ product.title | escape }}"
                    data-shopify-xr-hidden
                  >
                    <span class="svg-wrapper">
                      {% render 'icon-3d-model' %}
                    </span>
                    {{ 'products.product.xr_button' | t }}
                  </button>
                </div>
              </product-model>
          {% endcase %}
        </div>
      {% endfor %}
     {% endif %}      
    </div>
    {% if product.media.size > 1 and style == 'arrow' %}    
    {% render 'prev-next-controls',  placement_selector:'nav-collection-list nav_right', settings:settings, column_alignment : section.settings.column_alignment %}
    {% endif %}  
    {% if style == 'dots' %}
    <div class="swiper-pagination swiper-pagination-main w-100 "></div>
    {% endif %}
  </div>
  <!-- Thumbnails for gallery -->  
  <div tabindex="-1" class="swiper swiper-container product-thumbnails{% if product.media.size < 2 %} d-none{% endif %} {% if direction == 'stacked' %} d-none{% endif %} {% if direction == 'horizontal' %} mt-3 {% endif %} " data-direction="{{ direction }}">
    <div class="swiper-wrapper">
      {% for media in product.media %}
         {%  assign thumb_media_height = 300  | divided_by: media.preview_image.aspect_ratio | ceil %}
        <div class="swiper-slide thumbnail-slide media-child" data-media-id="{{ media.id }}">
          <div class="thumb_image">
          {% case media.media_type %}
            {% when 'image' %}
              {{ media.preview_image | image_url: width: 300, height: thumb_media_height | image_tag: loading: 'lazy' }}
            {% when 'video' %}
              {{ media.preview_image | image_url: width: 300, height: thumb_media_height | image_tag: loading: 'lazy' }}
             <div class="thumbnail__icon">
            {%- render 'icon-play' -%}
             </div>
            {% when 'external_video' %}
              {{ media.preview_image | image_url: width: 300, height: thumb_media_height | image_tag: loading: 'lazy' }}
            <div class="thumbnail__icon">
             {%- render 'icon-play' -%}
            </div>
            {% when 'model' %}
              {{ media.preview_image | image_url: width: 300, height: thumb_media_height | image_tag: loading: 'lazy' }}
            <div class="thumbnail__icon">
             {% render 'icon-3d-model' %}
            </div>  
          {% endcase %}
        </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper_thumb ">
      <div class="swiper-button-next thumb-next d-none">{% render 'next-icon' %}</div>
      <div class="swiper-button-prev thumb-prev d-none">{% render 'prev-icon' %}</div>
    </div>
  </div>

</wdt-main-media>
